<Window x:Class="LandLordBuddy.MVVM.Views.RecordPaymentDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:LandLordBuddy.MVVM.Converters"
        Title="Record Payment" Height="700" Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="SingleBorderWindow">
    <Window.Resources>
        <converters:IsNotNullToVisibilityConverter x:Key="IsNotNullToVisibilityConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Record Payment" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <!-- Select Tenancy -->
                <TextBlock Text="Select Tenancy" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <ComboBox ItemsSource="{Binding Tenancies}"
                         SelectedItem="{Binding SelectedTenancy}"
                         Margin="0,0,0,20"
                         Padding="5"
                         IsEditable="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="{Binding Tenant.FullName}"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Foreground="Gray">
                                    <Run Text="{Binding House.AddressLine1}"/>
                                    <Run Text=", "/>
                                    <Run Text="{Binding House.City}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Tenancy Details (Read-only) - Hidden when no tenancy selected -->
                <Border Background="#F5F5F5" Padding="15" Margin="0,0,0,20" CornerRadius="5" Visibility="{Binding SelectedTenancy, Converter={StaticResource IsNotNullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Tenancy Details" FontWeight="Bold" Margin="0,0,0,10"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                                <RowDefinition/>
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="House:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SelectedTenancy.House.AddressLine1, TargetNullValue='N/A', FallbackValue='N/A'}" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tenant:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedTenancy.Tenant.FullName, TargetNullValue='N/A', FallbackValue='N/A'}"/>

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Monthly Rent:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedTenancy.RentAmountMonthly, StringFormat='£{0:N2}', TargetNullValue='£0.00', FallbackValue='£0.00'}"/>

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Deposit Required:" FontWeight="Bold"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedTenancy.DepositAmount, StringFormat='£{0:N2}', TargetNullValue='£0.00', FallbackValue='£0.00'}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Payment Details -->
                <TextBlock Text="Payment Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Payment Date:" VerticalAlignment="Center"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding PaymentDate}" Padding="5"/>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Payment Method:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="PaymentMethodComboBox" Grid.Column="1" 
                             Padding="5" SelectionChanged="PaymentMethodComboBox_SelectionChanged">
                        <ComboBox.Items>
                            <ComboBoxItem Content="Bank Transfer" Tag="BankTransfer"/>
                            <ComboBoxItem Content="Cash" Tag="Cash"/>
                            <ComboBoxItem Content="Card" Tag="Card"/>
                            <ComboBoxItem Content="Other" Tag="Other"/>
                        </ComboBox.Items>
                    </ComboBox>
                </Grid>

                <Grid Margin="0,0,0,15">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Reference:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Reference, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
                </Grid>

                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Grid.Column="0" Text="Notes:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Notes, UpdateSourceTrigger=PropertyChanged}" 
                             Padding="5" TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>
                </Grid>

                <Separator Margin="0,0,0,15"/>

                <!-- Deposit Payment -->
                <TextBlock Text="Deposit Payment" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border Background="#E8F5E9" Padding="15" Margin="0,0,0,15" CornerRadius="5">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Required Deposit:" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding SelectedTenancy.DepositAmount, StringFormat='£{0:N2}', TargetNullValue='£0.00'}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Already Paid:" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding TotalDepositPaid, StringFormat='£{0:N2}'}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Remaining:" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" Text="{Binding DepositRemaining, StringFormat='£{0:N2}'}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pay Deposit:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged}" Padding="5">
                                <TextBox.ToolTip>
                                    <ToolTip Content="Enter deposit amount to pay"/>
                                </TextBox.ToolTip>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Rent Payment -->
                <TextBlock Text="Rent Payment" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                <Border Background="#E3F2FD" Padding="15" Margin="0,0,0,15" CornerRadius="5">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Period:" VerticalAlignment="Center"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <ComboBox x:Name="MonthComboBox" Width="120" Margin="0,0,10,0" Padding="5" SelectionChanged="MonthComboBox_SelectionChanged">
                                    <ComboBox.Items>
                                        <ComboBoxItem Content="January"/>
                                        <ComboBoxItem Content="February"/>
                                        <ComboBoxItem Content="March"/>
                                        <ComboBoxItem Content="April"/>
                                        <ComboBoxItem Content="May"/>
                                        <ComboBoxItem Content="June"/>
                                        <ComboBoxItem Content="July"/>
                                        <ComboBoxItem Content="August"/>
                                        <ComboBoxItem Content="September"/>
                                        <ComboBoxItem Content="October"/>
                                        <ComboBoxItem Content="November"/>
                                        <ComboBoxItem Content="December"/>
                                    </ComboBox.Items>
                                </ComboBox>
                                <ComboBox x:Name="YearComboBox" Width="100" Padding="5" SelectionChanged="YearComboBox_SelectionChanged">
                                    <ComboBox.Items>
                                        <ComboBoxItem Content="2024" Tag="2024" x:Name="Year2024"/>
                                        <ComboBoxItem Content="2025" Tag="2025" x:Name="Year2025"/>
                                        <ComboBoxItem Content="2026" Tag="2026" x:Name="Year2026"/>
                                        <ComboBoxItem Content="2027" Tag="2027" x:Name="Year2027"/>
                                    </ComboBox.Items>
                                </ComboBox>
                            </StackPanel>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Amount Due:" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding SelectedTenancy.RentAmountMonthly, StringFormat='£{0:N2}', TargetNullValue='£0.00'}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Already Paid:" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" Text="{Binding TotalRentPaidForPeriod, StringFormat='£{0:N2}'}"/>
                        </Grid>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Remaining:" FontWeight="Bold"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" Text="{Binding RentRemaining, StringFormat='£{0:N2}'}"/>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Pay Rent:" VerticalAlignment="Center"/>
                            <TextBox Grid.Column="1" Text="{Binding RentAmount, UpdateSourceTrigger=PropertyChanged}" Padding="5">
                                <TextBox.ToolTip>
                                    <ToolTip Content="Enter rent amount to pay for selected period"/>
                                </TextBox.ToolTip>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Total -->
                <Border Background="#FFF3E0" Padding="15" CornerRadius="5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Total Payment:" FontWeight="Bold" FontSize="16"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18" Text="{Binding TotalPayment, StringFormat='£{0:N2}'}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="100" Height="35" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Save" Width="100" Height="35" Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
