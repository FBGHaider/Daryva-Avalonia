<UserControl x:Class="LandLordBuddy.MVVM.Views.DocumentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:LandLordBuddy.MVVM.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:DocumentTypeDisplayConverter x:Key="DocumentTypeDisplayConverter"/>
        
        <!-- Status badge color converter -->
        <Style x:Key="StatusBadgeStyle" TargetType="Border">
            <Setter Property="Background" Value="#9E9E9E"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Padding" Value="6,2"/>
        </Style>
    </UserControl.Resources>
    
    <ScrollViewer>
        <StackPanel Margin="20">
            <TextBlock Text="Documents" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>
            
            <!-- Filters -->
            <GroupBox Header="Filters" Margin="0,0,0,20" Padding="10">
                <WrapPanel Orientation="Horizontal">
                    <!-- Owner Filter -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5">
                        <TextBlock Text="Owner Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox SelectedValue="{Binding OwnerFilter}" 
                                 SelectedValuePath="Content"
                                 Width="180" Padding="5">
                            <ComboBox.Items>
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="Tenant"/>
                                <ComboBoxItem Content="Tenancy"/>
                                <ComboBoxItem Content="House"/>
                            </ComboBox.Items>
                        </ComboBox>
                    </StackPanel>
                    
                    <!-- Tenant Selection (visible when OwnerFilter = Tenant) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5"
                              Visibility="{Binding OwnerFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Tenant}">
                        <TextBlock Text="Tenant:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Tenants}"
                                 SelectedValue="{Binding SelectedTenantId}"
                                 SelectedValuePath="TenantId"
                                 DisplayMemberPath="FullName"
                                 Width="180" Padding="5"/>
                    </StackPanel>
                    
                    <!-- House Selection (visible when OwnerFilter = House) -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,20,5"
                              Visibility="{Binding OwnerFilter, Converter={StaticResource StringEqualsConverter}, ConverterParameter=House}">
                        <TextBlock Text="House:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding Houses}"
                                 SelectedValue="{Binding SelectedHouseId}"
                                 SelectedValuePath="HouseId"
                                 DisplayMemberPath="AddressLine1"
                                 Width="180" Padding="5"/>
                    </StackPanel>
                    
                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,5">
                        <TextBlock Text="Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox ItemsSource="{Binding AvailableDocumentTypes}"
                                 SelectedItem="{Binding SelectedDocumentTypeForUpload}"
                                 Width="200" Margin="0,0,10,0" Padding="5"
                                 ToolTip="Select document type for upload">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <TextBlock.Text>
                                            <Binding>
                                                <Binding.Converter>
                                                    <converters:DocumentTypeDisplayConverter/>
                                                </Binding.Converter>
                                            </Binding>
                                        </TextBlock.Text>
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <Button Content="Upload Document" 
                               Command="{Binding UploadDocumentCommand}" 
                               Padding="15,8" 
                               Margin="5,0,0,0"
                               Background="#2196F3"
                               Foreground="White"
                               BorderThickness="0"/>
                    </StackPanel>
                </WrapPanel>
            </GroupBox>
            
            <!-- Document Status Checklist -->
            <GroupBox Header="Document Status Checklist" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto" MinHeight="200"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Action Buttons -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,10">
                        <Button Content="View" 
                               Command="{Binding ViewDocumentCommand}" 
                               Padding="10,5" 
                               Margin="0,0,5,0"
                               IsEnabled="{Binding SelectedDocumentStatus.DocumentId, Converter={StaticResource IsNotNullConverter}}"/>
                        <Button Content="Download" 
                               Command="{Binding DownloadDocumentCommand}" 
                               Padding="10,5" 
                               Margin="0,0,5,0"
                               IsEnabled="{Binding SelectedDocumentStatus.DocumentId, Converter={StaticResource IsNotNullConverter}}"/>
                        <Button Content="Delete" 
                               Command="{Binding DeleteDocumentCommand}" 
                               Padding="10,5" 
                               Margin="0,0,5,0"
                               Background="#F44336"
                               Foreground="White"
                               BorderThickness="0"
                               IsEnabled="{Binding SelectedDocumentStatus.DocumentId, Converter={StaticResource IsNotNullConverter}}"/>
                        <Button Content="View History" 
                               Command="{Binding ViewHistoryCommand}" 
                               Padding="10,5"
                               IsEnabled="{Binding SelectedDocumentStatus, Converter={StaticResource IsNotNullConverter}}"/>
                    </StackPanel>
                    
                    <!-- Checklist Table -->
                    <DataGrid Grid.Row="1" 
                             ItemsSource="{Binding DocumentStatusChecklist}" 
                             SelectedItem="{Binding SelectedDocumentStatus}"
                             AutoGenerateColumns="False" 
                             IsReadOnly="True"
                             GridLinesVisibility="All"
                             HeadersVisibility="Column"
                             MinHeight="200"
                             Height="Auto"
                             Margin="10,0,10,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Document Type" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTemplateColumn Header="Status" Width="150">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource StatusBadgeStyle}">
                                            <Border.Background>
                                                <Binding Path="Status">
                                                    <Binding.Converter>
                                                        <converters:StatusToColorConverter/>
                                                    </Binding.Converter>
                                                </Binding>
                                            </Border.Background>
                                            <TextBlock Text="{Binding Status}" 
                                                      Foreground="White" 
                                                      FontWeight="Bold" 
                                                      HorizontalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Uploaded" Width="120">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="UploadedDate" StringFormat="{}{0:yyyy-MM-dd}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Valid To" Width="120">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ValidTo" StringFormat="{}{0:yyyy-MM-dd}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
            
            <!-- Document List (All Documents) -->
            <GroupBox Header="All Documents" Margin="0,0,0,20">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    
                    <!-- Type Filter and Actions -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="10,10,10,10">
                        <TextBlock Text="Type Filter:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                        <ComboBox SelectedValue="{Binding TypeFilter}" 
                                 SelectedValuePath="Content"
                                 Width="200" Padding="5" Margin="0,0,20,0">
                            <ComboBox.Items>
                                <ComboBoxItem Content="All"/>
                                <ComboBoxItem Content="StudentConfirmationLetter"/>
                                <ComboBoxItem Content="PhotoId"/>
                                <ComboBoxItem Content="RightToRent"/>
                                <ComboBoxItem Content="TenancyAgreementSigned"/>
                                <ComboBoxItem Content="GuarantorAgreement"/>
                                <ComboBoxItem Content="InventoryCheckIn"/>
                                <ComboBoxItem Content="DepositProtectionCertificate"/>
                                <ComboBoxItem Content="NoticeToLeave"/>
                                <ComboBoxItem Content="Other"/>
                            </ComboBox.Items>
                        </ComboBox>
                        <Button Content="Delete All Documents (Test)" 
                               Command="{Binding DeleteAllDocumentsCommand}" 
                               Padding="15,8" 
                               Margin="5,0,0,0"
                               Background="#F44336"
                               Foreground="White"
                               BorderThickness="0"
                               ToolTip="Delete all documents - Test only"/>
                    </StackPanel>
                    
                    <!-- Documents Table -->
                    <DataGrid Grid.Row="1" 
                             ItemsSource="{Binding Documents}" 
                             AutoGenerateColumns="False" 
                             IsReadOnly="True"
                             GridLinesVisibility="All"
                             HeadersVisibility="Column"
                             Margin="10,0,10,10">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Type" Binding="{Binding DisplayName}" Width="*"/>
                            <DataGridTextColumn Header="Tenant Name" Binding="{Binding TenantName}" Width="*"/>
                            <DataGridTextColumn Header="File Name" Binding="{Binding FileName}" Width="*"/>
                            <DataGridTextColumn Header="Uploaded" Width="120">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="UploadedAt" StringFormat="{}{0:yyyy-MM-dd}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Valid To" Width="120">
                                <DataGridTextColumn.Binding>
                                    <Binding Path="ValidTo" StringFormat="{}{0:yyyy-MM-dd}"/>
                                </DataGridTextColumn.Binding>
                            </DataGridTextColumn>
                            <DataGridTextColumn Header="Version" Binding="{Binding Version}" Width="80"/>
                            <DataGridTextColumn Header="Source" Binding="{Binding Source}" Width="100"/>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </GroupBox>
        </StackPanel>
    </ScrollViewer>
</UserControl>
