<Window x:Class="LandLordBuddy.MVVM.Views.AddHouseDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add House" Height="450" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Add New House" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Address Line 1:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding AddressLine1, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Address Line 2:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding AddressLine2, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="City:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding City, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Postcode:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Postcode, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Total Rooms:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding TotalRooms, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="100" Height="35" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Save" Width="100" Height="35" Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
