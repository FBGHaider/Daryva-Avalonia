<Window x:Class="LandLordBuddy.MVVM.Views.EditTenantDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit Tenant" Height="650" Width="500"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Edit Tenant" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"/>

        <StackPanel Grid.Row="1">
            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Full Name:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Email:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Email, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Phone Number:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding PhoneNumber, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="University:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding UniversityName, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </Grid>

            <Separator Margin="0,10,0,15"/>

            <TextBlock Text="Assign to House" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="House:" VerticalAlignment="Center"/>
                <ComboBox Grid.Column="1" 
                         ItemsSource="{Binding Houses}"
                         SelectedItem="{Binding SelectedHouse}"
                         Padding="5"
                         IsEditable="False">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock>
                                <Run Text="{Binding AddressLine1}"/>
                                <Run Text=", " Foreground="Gray"/>
                                <Run Text="{Binding City}"/>
                            </TextBlock>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Monthly Rent:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding RentAmountMonthly, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Deposit:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding DepositAmount, UpdateSourceTrigger=PropertyChanged}" Padding="5"/>
            </Grid>

            <Grid Margin="0,0,0,15">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="120"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="Payment Due Day:" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding PaymentDueDay, UpdateSourceTrigger=PropertyChanged}" Padding="5">
                    <TextBox.ToolTip>
                        <ToolTip Content="Day of month (1-28) when rent is due"/>
                    </TextBox.ToolTip>
                </TextBox>
            </Grid>
        </StackPanel>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
            <Button Content="Cancel" Width="100" Height="35" Margin="0,0,10,0" Click="CancelButton_Click"/>
            <Button Content="Save" Width="100" Height="35" Command="{Binding SaveCommand}" IsDefault="True"/>
        </StackPanel>
    </Grid>
</Window>
