<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="BrandPrimary">#FA9704</Color>
    <Color x:Key="BrandSecondary">#0289CD</Color>
    <Color x:Key="StatusDanger">#F35B05</Color>
    <Color x:Key="StatusSuccess">#6BAB26</Color>
    <Color x:Key="StatusWarning">#F6A609</Color>
    <Color x:Key="DeepBlue">#034D91</Color>
    <Color x:Key="Teal">#1E745A</Color>
    <Color x:Key="AccentPurple">#7C6FE0</Color>

    <Color x:Key="Bg">#F4F7FF</Color>
    <Color x:Key="Surface">#FFFFFF</Color>
    <Color x:Key="Surface2">#EEF3FF</Color>
    <Color x:Key="ElevatedSurface">#FBFCFF</Color>
    <Color x:Key="Border">#D6DEEF</Color>
    <Color x:Key="TextPrimary">#1B2540</Color>
    <Color x:Key="TextMuted">#5D6B8B</Color>

    <Color x:Key="PrimaryBackground">#F4F7FF</Color>
    <Color x:Key="SecondaryBackground">#FFFFFF</Color>
    <Color x:Key="NavigationBackground">#E9EFFD</Color>
    <Color x:Key="ControlBackground">#EEF3FF</Color>
    <Color x:Key="ControlBackgroundHover">#E1E9FB</Color>
    <Color x:Key="BorderColor">#D6DEEF</Color>
    <Color x:Key="PrimaryText">#1B2540</Color>
    <Color x:Key="SecondaryText">#5D6B8B</Color>
    <Color x:Key="AccentColor">#FA9704</Color>
    <Color x:Key="AccentColorHover">#FFAC30</Color>

    <Color x:Key="CardHousesBackground">#FFFFFF</Color>
    <Color x:Key="CardTenantsBackground">#FFFFFF</Color>
    <Color x:Key="CardOverdueBackground">#FFFFFF</Color>
    <Color x:Key="CardDocumentsBackground">#FFFFFF</Color>

    <Color x:Key="TableHeaderBackground">#DEE9FC</Color>
    <Color x:Key="TableRowEvenBackground">#FFFFFF</Color>
    <Color x:Key="TableRowOddBackground">#F6F9FF</Color>
    
    <!-- Semantic + accent brushes, and the new subtle-semantic/purple/elevated-surface tokens.
         Subtle tints use higher opacity than dark mode, since low-alpha tints wash out against a
         near-white surface. -->
    <SolidColorBrush x:Key="StatusDangerBrush" Color="{StaticResource StatusDanger}"/>
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="{StaticResource StatusSuccess}"/>
    <SolidColorBrush x:Key="StatusWarningBrush" Color="{StaticResource StatusWarning}"/>
    <SolidColorBrush x:Key="AccentPurpleBrush" Color="{StaticResource AccentPurple}"/>
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="{StaticResource StatusSuccess}" Opacity="0.14"/>
    <SolidColorBrush x:Key="WarningSubtleBrush" Color="{StaticResource StatusWarning}" Opacity="0.16"/>
    <SolidColorBrush x:Key="DangerSubtleBrush" Color="{StaticResource StatusDanger}" Opacity="0.14"/>
    <SolidColorBrush x:Key="InfoSubtleBrush" Color="{StaticResource BrandSecondary}" Opacity="0.12"/>
    <SolidColorBrush x:Key="AccentPurpleSubtleBrush" Color="{StaticResource AccentPurple}" Opacity="0.14"/>
    <SolidColorBrush x:Key="ElevatedSurfaceBrush" Color="{StaticResource ElevatedSurface}"/>

    <!-- Base Brushes -->
    <SolidColorBrush x:Key="PrimaryBackgroundBrush" Color="{StaticResource PrimaryBackground}"/>
    <SolidColorBrush x:Key="SecondaryBackgroundBrush" Color="{StaticResource SecondaryBackground}"/>
    <SolidColorBrush x:Key="NavigationBackgroundBrush" Color="{StaticResource NavigationBackground}"/>
    <SolidColorBrush x:Key="ControlBackgroundBrush" Color="{StaticResource ControlBackground}"/>
    <SolidColorBrush x:Key="ControlBackgroundHoverBrush" Color="{StaticResource ControlBackgroundHover}"/>
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}"/>
    <SolidColorBrush x:Key="PrimaryTextBrush" Color="{StaticResource PrimaryText}"/>
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryText}"/>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <SolidColorBrush x:Key="AccentHoverBrush" Color="{StaticResource AccentColorHover}"/>
    
    <!-- Dashboard Card Brushes -->
    <SolidColorBrush x:Key="CardHousesBackgroundBrush" Color="{StaticResource CardHousesBackground}"/>
    <SolidColorBrush x:Key="CardTenantsBackgroundBrush" Color="{StaticResource CardTenantsBackground}"/>
    <SolidColorBrush x:Key="CardOverdueBackgroundBrush" Color="{StaticResource CardOverdueBackground}"/>
    <SolidColorBrush x:Key="CardDocumentsBackgroundBrush" Color="{StaticResource CardDocumentsBackground}"/>
    
    <!-- Table Brushes -->
    <SolidColorBrush x:Key="TableHeaderBackgroundBrush" Color="{StaticResource TableHeaderBackground}"/>
    <SolidColorBrush x:Key="TableRowEvenBackgroundBrush" Color="{StaticResource TableRowEvenBackground}"/>
    <SolidColorBrush x:Key="TableRowOddBackgroundBrush" Color="{StaticResource TableRowOddBackground}"/>
</ResourceDictionary>
