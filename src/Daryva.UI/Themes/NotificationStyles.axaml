<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Drawer overlay -->
    <Style Selector="Border.notification-overlay">
        <Setter Property="Background" Value="#40000000"/>
    </Style>
    <!-- Drawer panel -->
    <Style Selector="Border.notification-drawer">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="CornerRadius" Value="12,0,0,12"/>
        <Setter Property="BoxShadow" Value="0 0 24 0 #30000000"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="380"/>
        <Setter Property="MaxWidth" Value="440"/>
    </Style>
    <!-- Notification item row -->
    <Style Selector="Border.notification-item">
        <Setter Property="Padding" Value="14,12"/>
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="Transitions">
            <Transitions>
                <BrushTransition Property="Background" Duration="0:0:0.12"/>
            </Transitions>
        </Setter>
    </Style>
    <Style Selector="Border.notification-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
    </Style>
    <!-- Profile drawer panel (same as notification drawer) -->
    <Style Selector="Border.profile-drawer">
        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1,0,0,0"/>
        <Setter Property="CornerRadius" Value="12,0,0,12"/>
        <Setter Property="BoxShadow" Value="0 0 24 0 #30000000"/>
        <Setter Property="Padding" Value="0"/>
        <Setter Property="MinWidth" Value="280"/>
        <Setter Property="MaxWidth" Value="320"/>
    </Style>
    <Style Selector="Button.profile-menu-item">
        <Setter Property="Background" Value="Transparent"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="Padding" Value="20,12"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
    </Style>
    <Style Selector="Button.profile-menu-item:pointerover">
        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
    </Style>
    <!-- Unread indicator dot -->
    <Style Selector="Border.notification-unread-dot">
        <Setter Property="Width" Value="8"/>
        <Setter Property="Height" Value="8"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
    </Style>
</Styles>
