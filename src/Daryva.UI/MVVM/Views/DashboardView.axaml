<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Daryva.MVVM.Views.Controls"
             x:Class="Daryva.MVVM.Views.DashboardView"
             x:CompileBindings="False"
             Padding="28">
    <UserControl.Styles>
        <Style Selector="Border.surface-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Button.quick-action">
            <Setter Property="Padding" Value="12,8"/>
            <Setter Property="Background" Value="#1A243D"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="Background" Duration="0:0:0.14"/>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Button.quick-action:pointerover">
            <Setter Property="Background" Value="#223152"/>
            <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}"/>
        </Style>
        <Style Selector="TextBox.top-search">
            <Setter Property="Width" Value="260"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="20">
            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                    <TextBlock Text="Dashboard" Classes="page-title"/>
                    <TextBlock Text="{Binding GreetingText}" Classes="text-muted" FontSize="14"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <TextBox Classes="top-search" Watermark="Search..."/>
                    <Button Content="🔔" Width="36" Height="36"/>
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1">
                        <TextBlock Text="👤" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                </StackPanel>
            </Grid>

            <Grid ColumnDefinitions="*,*,*,*">
                <controls:KpiCard Grid.Column="0"
                                  Margin="0,0,14,0"
                                  Title="Houses"
                                  Value="{Binding HousesCount}"
                                  Icon="🏠"
                                  AccentBrush="{DynamicResource BrandPrimaryBrush}"/>

                <controls:KpiCard Grid.Column="1"
                                  Margin="0,0,14,0"
                                  Title="Active Tenants"
                                  Value="{Binding ActiveTenantsCount}"
                                  Icon="👥"
                                  AccentBrush="{DynamicResource StatusSuccessBrush}"/>

                <controls:KpiCard Grid.Column="2"
                                  Margin="0,0,14,0"
                                  Title="Overdue Rent"
                                  Value="{Binding OverdueRentCount}"
                                  SubText="{Binding OverdueRentAmount, StringFormat='£{0:N2} pending'}"
                                  Icon="⚠"
                                  AccentBrush="{DynamicResource StatusDangerBrush}"/>

                <controls:KpiCard Grid.Column="3"
                                  Title="Documents Expiring"
                                  Value="{Binding DocumentsExpiringSoonCount}"
                                  Icon="📄"
                                  AccentBrush="{DynamicResource BrandSecondaryBrush}"/>
            </Grid>

            <Border Classes="surface-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Quick Actions" Classes="section-title"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Classes="quick-action" Content="➕ Add House" Command="{Binding AddHouseCommand}" Margin="0,0,10,10"/>
                        <Button Classes="quick-action" Content="👤 Add Tenant" Command="{Binding AddTenantCommand}" Margin="0,0,10,10"/>
                        <Button Classes="quick-action" Content="💷 Record Payment" Command="{Binding RecordPaymentCommand}" Margin="0,0,10,10"/>
                        <Button Classes="quick-action" Content="📤 Upload Document" Command="{Binding UploadDocumentCommand}" Margin="0,0,10,10"/>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <Border Classes="surface-card">
                <StackPanel Spacing="12">
                    <TextBlock Text="Deposit Return Reminders" Classes="section-title"/>
                    <TextBlock Text="When a tenant leaves, reminders appear here." Classes="text-muted" FontSize="12"/>

                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="0" IsVisible="{Binding ShowEmptyDepositMessage, Converter={x:Static BoolConverters.Not}}">
                        <Grid ColumnDefinitions="2*,2*,*,*">
                            <TextBlock Grid.Column="0" Text="Tenant" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Padding="16,10"/>
                            <TextBlock Grid.Column="1" Text="House" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Padding="16,10"/>
                            <TextBlock Grid.Column="2" Text="Leave Date" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Padding="16,10" HorizontalAlignment="Right"/>
                            <TextBlock Grid.Column="3" Text="Amount" FontWeight="SemiBold" Foreground="{DynamicResource TextMutedBrush}" Padding="16,10" HorizontalAlignment="Right"/>
                        </Grid>
                    </Border>

                    <ItemsControl ItemsSource="{Binding DepositReturnReminders}" IsVisible="{Binding ShowEmptyDepositMessage, Converter={x:Static BoolConverters.Not}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1">
                                    <Grid ColumnDefinitions="2*,2*,*,*">
                                        <TextBlock Grid.Column="0" Text="{Binding TenantName}" Padding="16,10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="1" Text="{Binding HouseAddress}" Padding="16,10" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="2" Text="{Binding LeaveDateDisplay}" Padding="16,10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                        <TextBlock Grid.Column="3" Text="{Binding AmountToReturn, StringFormat='£{0:N2}'}" Padding="16,10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="10" Padding="24" IsVisible="{Binding ShowEmptyDepositMessage}">
                        <StackPanel HorizontalAlignment="Center" Spacing="8">
                            <TextBlock Text="✅" FontSize="36" HorizontalAlignment="Center"/>
                            <TextBlock Text="All deposits are up to date" Classes="section-title" HorizontalAlignment="Center"/>
                            <TextBlock Text="When a tenant leaves, reminders appear here." Classes="text-muted" HorizontalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
