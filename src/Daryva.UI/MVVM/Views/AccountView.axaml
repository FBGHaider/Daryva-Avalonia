<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Daryva.MVVM.Views.AccountView"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="ListBox#AccountSectionsList">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
        </Style>
        <Style Selector="ListBox#AccountSectionsList ListBoxItem">
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Margin" Value="0,2"/>
            <Setter Property="CornerRadius" Value="6"/>
        </Style>
        <Style Selector="ListBox#AccountSectionsList ListBoxItem:selected">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox#AccountSectionsList ListBoxItem:selected Border">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="BorderThickness" Value="3,0,0,0"/>
        </Style>
        <Style Selector="ListBox#AccountSectionsList ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox#AccountSectionsList ListBoxItem:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        </Style>
    </UserControl.Styles>
    <Border Padding="20" Background="{DynamicResource BgBrush}">
        <Grid ColumnDefinitions="220,*">
            <!-- Left: Account sections -->
            <Border Grid.Column="0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="14,20"
                    MinWidth="200">
                <StackPanel Spacing="4">
                    <TextBlock Text="Account"
                               FontSize="18"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,16"/>
                    <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                        <ListBox x:Name="AccountSectionsList"
                                 ItemsSource="{Binding Sections}"
                                 SelectedItem="{Binding SelectedSection}"
                                 SelectionMode="Single">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border Padding="12,10" CornerRadius="6" BorderThickness="3,0,0,0" BorderBrush="Transparent">
                                        <TextBlock Text="{Binding}"
                                                   VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TextMutedBrush}"
                                                   FontSize="14"/>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </ScrollViewer>
                </StackPanel>
            </Border>

            <!-- Right: Header + content -->
            <Border Grid.Column="1"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24"
                    ClipToBounds="True">
                <Grid RowDefinitions="Auto,*">
                    <StackPanel Grid.Row="0" Margin="0,0,0,20" Spacing="4">
                        <TextBlock Text="Account" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Manage your profile, security and notification preferences."
                                   FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        <TextBlock FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,4,0,0">
                            <Run Text="Account"/>
                            <Run Text=" / "/>
                            <Run Text="{Binding SelectedSection}"/>
                        </TextBlock>
                    </StackPanel>

                    <ContentControl Grid.Row="1" Content="{Binding CurrentSectionViewModel}" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
