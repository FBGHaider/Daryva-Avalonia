<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Daryva.MVVM.Views.Controls"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Daryva.MVVM.Views.Controls.ProfileDrawer"
             x:Name="ProfileDrawerRoot"
             Focusable="True"
             x:CompileBindings="False">
    <UserControl.KeyBindings>
        <KeyBinding Gesture="Escape" Command="{Binding CloseCommand}"/>
    </UserControl.KeyBindings>
    <UserControl.Styles>
        <StyleInclude Source="avares://Daryva/Themes/NotificationStyles.axaml"/>
    </UserControl.Styles>
    <Grid IsVisible="{Binding IsOpen}">
        <!-- Overlay: click to close -->
        <Border Classes="notification-overlay"
                Background="#40000000"
                ZIndex="0"
                PointerPressed="Overlay_PointerPressed"/>
        <!-- Right-side panel (same pattern as notification drawer) -->
        <Border Classes="profile-drawer"
                HorizontalAlignment="Right"
                ZIndex="1"
                Width="300">
            <StackPanel>
                <!-- Header -->
                <Border Padding="20,20" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1">
                    <StackPanel Spacing="4">
                        <TextBlock Text="Account" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="{Binding UserDisplayName}" FontSize="14" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock Text="{Binding OrgName}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" TextTrimming="CharacterEllipsis" IsVisible="{Binding HasOrgName}"/>
                    </StackPanel>
                </Border>
                <!-- Menu items -->
                <Button Classes="profile-menu-item" Command="{Binding OpenMyProfileCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="AccountOutline" Width="16" Height="16"/>
                        <TextBlock Text="My account"/>
                    </StackPanel>
                </Button>
                <Button Classes="profile-menu-item" Command="{Binding OpenOrganisationCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="Domain" Width="16" Height="16"/>
                        <TextBlock Text="Organisation / team"/>
                    </StackPanel>
                </Button>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="12,0"/>
                <Button Classes="profile-menu-item" Command="{Binding OpenPreferencesCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="CogOutline" Width="16" Height="16"/>
                        <TextBlock Text="Preferences"/>
                    </StackPanel>
                </Button>
                <Button Classes="profile-menu-item" Command="{Binding OpenSupportCommand}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="HelpCircleOutline" Width="16" Height="16"/>
                        <TextBlock Text="Help &amp; support"/>
                    </StackPanel>
                </Button>
                <Border Height="1" Background="{DynamicResource BorderBrush}" Margin="12,0"/>
                <Button Classes="profile-menu-item" Command="{Binding LogoutCommand}" Foreground="{DynamicResource StatusDangerBrush}">
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <materialIcons:MaterialIcon Kind="LogoutVariant" Width="16" Height="16"/>
                        <TextBlock Text="Log out"/>
                    </StackPanel>
                </Button>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
