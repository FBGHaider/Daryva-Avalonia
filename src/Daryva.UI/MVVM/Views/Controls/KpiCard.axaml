<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Daryva.MVVM.Views.Controls"
             xmlns:materialIcons="using:Material.Icons.Avalonia"
             x:Class="Daryva.MVVM.Views.Controls.KpiCard"
             x:Name="Root"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="Border.kpi-card">
            <Setter Property="CornerRadius" Value="{DynamicResource RadiusMedium}"/>
            <Setter Property="Padding" Value="16"/>
            <Setter Property="Background" Value="{DynamicResource ElevatedSurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Transitions">
                <Transitions>
                    <BrushTransition Property="BorderBrush" Duration="0:0:0.14"/>
                </Transitions>
            </Setter>
        </Style>
        <Style Selector="Border.kpi-card:pointerover">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        </Style>
    </UserControl.Styles>

    <!-- Typography-first: the metric itself is the visual focus. Icon is a small, muted glyph
         next to the title, not a large decoration competing with the value for attention. -->
    <Border Classes="kpi-card">
        <Grid RowDefinitions="4,Auto,Auto,Auto">
            <Border Grid.Row="0"
                    CornerRadius="{DynamicResource RadiusSmall}"
                    Background="{Binding AccentBrush, ElementName=Root}"/>

            <Grid Grid.Row="1" ColumnDefinitions="*,Auto" Margin="0,12,0,0">
                <TextBlock Grid.Column="0"
                           Classes="card-title"
                           Text="{Binding Title, ElementName=Root}"
                           VerticalAlignment="Center"/>
                <materialIcons:MaterialIcon Grid.Column="1"
                           Kind="{Binding Icon, ElementName=Root}"
                           Width="18" Height="18"
                           Foreground="{DynamicResource TextMutedBrush}"
                           VerticalAlignment="Center"
                           IsVisible="{Binding HasIcon, ElementName=Root}"/>
            </Grid>

            <TextBlock Grid.Row="2"
                       Classes="kpi-value"
                       Text="{Binding Value, ElementName=Root}"
                       Margin="0,8,0,0"/>

            <TextBlock Grid.Row="3"
                       Classes="text-muted"
                       FontSize="12"
                       Margin="0,8,0,0"
                       Text="{Binding SubText, ElementName=Root}"
                       IsVisible="{Binding HasSubText, ElementName=Root}"/>
        </Grid>
    </Border>
</UserControl>
