<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Daryva.MVVM.Converters"
             x:Class="Daryva.MVVM.Views.OrganisationView"
             x:CompileBindings="False"
             x:Name="Root">
    <UserControl.Resources>
        <converters:IsPrimaryOwnerToBadgeBrushConverter x:Key="IsPrimaryOwnerToBadgeBrushConverter"/>
        <converters:MemberStatusToBadgeBrushConverter x:Key="MemberStatusToBadgeBrushConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <!-- Match Houses/Dashboard: card and chip styles -->
        <Style Selector="Border.command-bar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Border.stat-pill">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="Border.badge-role">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="Border.badge-status">
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style Selector="Button.member-action-btn">
            <Setter Property="Width" Value="36"/>
            <Setter Property="Height" Value="36"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.member-action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="Border.member-row">
            <Setter Property="Padding" Value="12,10"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,1"/>
        </Style>
        <Style Selector="Border.member-row:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        </Style>
    </UserControl.Styles>
    <Border Padding="24" Background="{DynamicResource BgBrush}">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="0" Margin="0,0,0,32">
                <!-- Page header: match Houses (title + subtitle + right pill) -->
                <Border Classes="command-bar" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                            <TextBlock Text="{Binding PageTitle}" Classes="page-title"/>
                            <TextBlock Text="{Binding Subtitle}" Classes="text-muted" FontSize="13" TextWrapping="Wrap"/>
                        </StackPanel>
                        <Border Grid.Column="1" Classes="stat-pill" VerticalAlignment="Center">
                            <TextBlock Text="{Binding CurrentOrganisationName}" FontSize="12" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </Border>
                    </Grid>
                </Border>

                <!-- Organisation card -->
                <Border Classes="command-bar" Margin="0,0,0,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Organisation" Classes="section-title" FontSize="16"/>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6">
                                <TextBlock Text="Current organisation" Classes="text-muted" FontSize="12"/>
                                <ComboBox ItemsSource="{Binding Organisations}"
                                          SelectedItem="{Binding SelectedOrganisation}"
                                          MinWidth="220"
                                          PlaceholderText="Select organisation"
                                          Background="{DynamicResource Surface2Brush}"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          BorderBrush="{DynamicResource BorderBrush}">
                                    <ComboBox.ItemTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                        </DataTemplate>
                                    </ComboBox.ItemTemplate>
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom" Margin="0,0,0,0">
                                <Button Content="Switch" Classes="secondary" Command="{Binding SwitchOrgCommand}"/>
                                <Button Content="Create organisation" Classes="primary" Command="{Binding CreateOrgCommand}"/>
                                <Button Content="Rename" Classes="secondary" Command="{Binding RenameOrgCommand}" IsEnabled="{Binding CanRenameOrg}"/>
                                <Button Content="Remove organisation" Classes="secondary" Command="{Binding RemoveOrgCommand}" ToolTip.Tip="Delete the selected organisation (Owner only)."/>
                            </StackPanel>
                            <WrapPanel Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,12,0,0">
                                <Border Classes="stat-pill" Margin="0,0,10,0">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Houses" Classes="text-muted" FontSize="12"/>
                                        <TextBlock Text="{Binding HousesCount}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                                <Border Classes="stat-pill">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="Active tenants" Classes="text-muted" FontSize="12"/>
                                        <TextBlock Text="{Binding ActiveTenantsCount}" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Team members card -->
                <Border Classes="command-bar" Margin="0,0,0,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Team members" Classes="section-title" FontSize="16"/>
                        <TextBox Watermark="Search team members…" Text="{Binding MemberSearchText}" Margin="0,0,0,4"/>
                        <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="0">
                            <ItemsControl ItemsSource="{Binding Members}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Classes="member-row">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Remove" Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto">
                                                <TextBlock Grid.Column="0" Text="{Binding DisplayLabel}" FontSize="14" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center"/>
                                                <Border Grid.Column="1" Classes="badge-role" Background="{Binding IsPrimaryOwner, Converter={StaticResource IsPrimaryOwnerToBadgeBrushConverter}}" Margin="8,0">
                                                    <TextBlock Text="{Binding RoleDisplay}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                                <Border Grid.Column="2" Classes="badge-status" Background="{Binding Status, Converter={StaticResource MemberStatusToBadgeBrushConverter}}" Margin="0,0,8,0">
                                                    <TextBlock Text="{Binding StatusDisplay}" FontSize="11" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                                </Border>
                                                <TextBlock Grid.Column="3" Text="{Binding JoinedAt, StringFormat='{}{0:dd MMM yyyy}'}" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" VerticalAlignment="Center"/>
                                                <Button Grid.Column="4" Classes="member-action-btn" Content="⋯" ToolTip.Tip="Actions">
                                                    <Button.Flyout>
                                                        <MenuFlyout Placement="Bottom">
                                                            <MenuItem Header="Remove" Command="{Binding DataContext.RemoveMemberCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" CommandParameter="{Binding}"/>
                                                        </MenuFlyout>
                                                    </Button.Flyout>
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Border>
                        <TextBlock Text="No team members yet. Use the form below to invite someone." Classes="text-muted" FontSize="13"
                                   IsVisible="{Binding IsMembersListEmpty}" Margin="0,8,0,0"/>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,14,0,0" Margin="0,14,0,0">
                            <StackPanel Spacing="10">
                                <TextBlock Text="Invite member" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <Grid ColumnDefinitions="*,Auto">
                                    <TextBox Grid.Column="0" Text="{Binding InviteEmail}" Watermark="Email address" Margin="0,0,12,0"/>
                                    <Button Grid.Column="1" Content="Send invite" Classes="primary" Command="{Binding InviteMemberCommand}"/>
                                </Grid>
                                <TextBlock Text="Enter an email address, then click Send invite. New members join as co-managing Landlords." Classes="text-muted" FontSize="12" Margin="0,4,0,0"/>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Border>

                <!-- Recovery code & restore (save org ID so you can get back to e.g. "2 houses") -->
                <Border Classes="command-bar" Margin="0,0,0,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Recovery &amp; restore" Classes="section-title" FontSize="16"/>
                        <TextBlock Text="Save your organisation ID somewhere safe (e.g. &quot;2 houses&quot;). If you ever lose access or switch accounts, you can paste it below to restore this organisation." 
                                   Classes="text-muted" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,4"/>
                        <Grid ColumnDefinitions="*,Auto" RowDefinitions="Auto,Auto">
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="4">
                                <TextBlock Text="Recovery code for current organisation" Classes="text-muted" FontSize="12"/>
                                <TextBox Text="{Binding RecoveryCode}" IsReadOnly="True" FontFamily="Consolas" FontSize="12" 
                                         Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" 
                                         Watermark="Select an organisation above"/>
                            </StackPanel>
                            <Button Grid.Row="0" Grid.Column="1" Content="Copy code" Classes="secondary" Command="{Binding CopyRecoveryCodeCommand}" 
                                    VerticalAlignment="Bottom" Margin="12,0,0,0"/>
                            <Border Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="0,12,0,0" Margin="0,12,0,0">
                                <StackPanel Spacing="8">
                                    <TextBlock Text="Have a recovery code? Paste it below to switch back to that organisation." Classes="text-muted" FontSize="12"/>
                                    <StackPanel Orientation="Horizontal" Spacing="12">
                                        <Button Content="Restore organisation from code…" Classes="secondary" Command="{Binding RestoreOrgCommand}"/>
                                        <Button Content="Backup now…" Classes="secondary" Command="{Binding BackupNowCommand}" ToolTip.Tip="Export API data (houses, tenants, tenancies, payments, deposit returns) to a JSON file"/>
                                        <Button Content="Restore from backup file…" Classes="secondary" Command="{Binding RestoreFromBackupCommand}" ToolTip.Tip="Import houses, tenants, tenancies, payments from a Daryva API backup JSON file"/>
                                        <Button Content="Export for rent repair…" Classes="secondary" Command="{Binding ExportForRentRepairCommand}" ToolTip.Tip="Export tenancies with current rent/deposit so you can fix wrong values (e.g. after migration)"/>
                                        <Button Content="Repair rent from file…" Classes="secondary" Command="{Binding RepairRentFromFileCommand}" ToolTip.Tip="Apply corrected rent/deposit from an edited export file"/>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Support access code: generate a short-lived code for Daryva support to look up this org directly -->
                <Border Classes="command-bar" Margin="0,0,0,16">
                    <StackPanel Spacing="14">
                        <TextBlock Text="Support access" Classes="section-title" FontSize="16"/>
                        <TextBlock Text="If you need help from Daryva support, generate a code and share it with them (phone, email, chat) -- it's quicker than them searching by your email, and expires automatically after 15 minutes."
                                   Classes="text-muted" FontSize="12" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <Button Content="Generate code" Classes="secondary" Command="{Binding GenerateSupportCodeCommand}"/>
                            <StackPanel Spacing="2" IsVisible="{Binding HasSupportAccessCode}" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" Spacing="10">
                                    <TextBox Text="{Binding SupportAccessCode}" IsReadOnly="True" FontFamily="Consolas" FontSize="16" FontWeight="Bold"
                                             Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}" Width="140"/>
                                    <Button Content="Copy" Classes="secondary" Command="{Binding CopySupportCodeCommand}"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SupportAccessCodeExpiresDisplay}" Classes="text-muted" FontSize="11"/>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Plan & billing (Coming soon) -->
                <Border Classes="command-bar" Margin="0,0,0,16">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Plan &amp; billing" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Classes="stat-pill" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock Text="Plan: Starter (Coming soon)" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Audit log (Coming soon) -->
                <Border Classes="command-bar">
                    <Grid ColumnDefinitions="*,Auto">
                        <StackPanel Grid.Column="0" Spacing="4">
                            <TextBlock Text="Audit log" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <Border Classes="stat-pill" HorizontalAlignment="Left" Margin="0,4,0,0">
                                <TextBlock Text="Coming soon" FontSize="12" Foreground="{DynamicResource TextMutedBrush}"/>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>
    </Border>
</UserControl>
