<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Daryva.MVVM.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Daryva.MVVM.Views.RentPaymentsView"
             x:CompileBindings="False"
             x:Name="Root">
    <UserControl.Styles>
        <Style Selector="Border.command-bar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
    </UserControl.Styles>
    <Grid RowDefinitions="Auto,*">
        <!-- Finance Command Bar -->
        <Border Grid.Row="0" x:Name="HeaderBorder" Padding="24" Margin="0,0,0,12">
            <Border Classes="command-bar">
                <Grid RowDefinitions="Auto">
                    <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                            <TextBlock Text="Rent &amp; Payments" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            <TextBlock Text="{Binding LedgerViewModel.SubtitleText}" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                                    IsVisible="{Binding IsHeaderButtonsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}">
                            <Button Content="Record Payment" Command="{Binding RecordPaymentCommand}"
                                    Background="{DynamicResource BrandPrimaryBrush}"
                                    Foreground="{DynamicResource TextPrimaryBrush}"
                                    BorderThickness="0" Padding="12,8" CornerRadius="8"/>
                            <Button Content="Export" Command="{Binding ExportLedgerCommand}"
                                    Background="Transparent"
                                    Foreground="{DynamicResource BrandPrimaryBrush}"
                                    BorderBrush="{DynamicResource BrandPrimaryBrush}"
                                    BorderThickness="1" Padding="12,8" CornerRadius="8"/>
                            <Button Content="⋯" ToolTip.Tip="More actions"
                                    Background="Transparent"
                                    Foreground="{DynamicResource TextMutedBrush}"
                                    BorderThickness="0" Padding="8">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="Refresh" Command="{Binding RefreshCommand}"/>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Border>

        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border Padding="24,0,24,24">
                <TabControl SelectedIndex="{Binding SelectedTabIndex}" Margin="0,0,0,0">
                    <TabItem Header="Rent Ledger">
                        <views:RentLedgerView DataContext="{Binding LedgerViewModel}"/>
                    </TabItem>
                    <TabItem Header="Transactions">
                        <views:TransactionsView DataContext="{Binding TransactionsViewModel}"/>
                    </TabItem>
                </TabControl>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
