<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Daryva.MVVM.Converters;assembly=Daryva"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="Daryva.MVVM.Views.GeneralSettingsView"
             x:CompileBindings="False">
    <UserControl.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
    </UserControl.Resources>
    <UserControl.Styles>
        <Style Selector="Border.settings-card">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <Style Selector="Border.settings-footer">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1,1,0,0"/>
            <Setter Property="Padding" Value="20,14"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*,Auto">
        <!-- Section header -->
        <TextBlock Grid.Row="0" Text="General Settings" FontSize="20" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,20"/>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20" Margin="0,0,0,0">
                <!-- Updates card -->
                <Border Classes="settings-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Updates" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Check for app updates and install new versions when available."
                                   FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="Auto,*" RowDefinitions="Auto,Auto" Margin="0,8,0,0">
                            <TextBlock Text="Current version:" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,0,12,0"/>
                            <TextBlock Grid.Column="1" Text="{Binding CurrentVersion}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                            <TextBlock Grid.Row="1" Text="Status:" VerticalAlignment="Center" Foreground="{DynamicResource TextMutedBrush}" FontSize="13" Margin="0,8,12,0"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding UpdateStatus}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13" Margin="0,8,0,0"/>
                        </Grid>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,12,0,0">
                            <Button Content="Check for updates" Command="{Binding CheckForUpdatesCommand}"
                                    IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InvertBoolConverter}}"
                                    Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8" CornerRadius="8"/>
                            <Button Content="Install &amp; Restart" Command="{Binding InstallAndRestartCommand}"
                                    IsVisible="{Binding AvailableUpdateVersion, Converter={StaticResource IsNotNullConverter}}"
                                    Background="{DynamicResource BrandPrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="12,8" CornerRadius="8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Diagnostics card -->
                <Border Classes="settings-card">
                    <StackPanel Spacing="12">
                        <TextBlock Text="Diagnostics" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="This session's activity log -- every page switch, organisation switch, API call, and error dialog, each timestamped. Copy it when reporting a bug."
                                   FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                            <Button Content="Copy session log" Command="{Binding CopySessionLogsCommand}"
                                    Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="12,8" CornerRadius="8"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Appearance & Behavior card - 2-column form -->
                <Border Classes="settings-card">
                    <StackPanel Spacing="16">
                        <TextBlock Text="Appearance &amp; Behavior" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        <TextBlock Text="Currency, date format, time zone and app startup."
                                   FontSize="13" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                        <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto">
                            <!-- Column A -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Spacing="6" Margin="0,0,8,0">
                                <TextBlock Text="Currency" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox Text="{Binding Currency, Mode=TwoWay}" MinWidth="0" Padding="10,8"
                                         Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" Watermark="e.g. GBP, £, USD"/>
                                <TextBlock Text="Used in notifications (e.g. {Currency}{AmountDue}). Codes: GBP, USD, EUR; or symbol £, $, €."
                                           FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Row="0" Grid.Column="1" Spacing="6" Margin="8,0,0,0">
                                <TextBlock Text="Date Format" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding DateFormatOptions}" SelectedItem="{Binding DateFormat, Mode=TwoWay}"
                                          MinWidth="0" Padding="8,6" PlaceholderText="Select format"
                                          Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="0" Spacing="6" Margin="0,8,8,0">
                                <TextBlock Text="Time Zone" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBox Text="{Binding TimeZone, Mode=TwoWay}" IsReadOnly="True" MinWidth="0" Padding="10,8"
                                         Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1" Spacing="6" Margin="8,8,0,0">
                                <TextBlock Text="App Start Page" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                                <ComboBox ItemsSource="{Binding AppStartPageOptions}" SelectedItem="{Binding AppStartPage, Mode=TwoWay}"
                                          MinWidth="0" Padding="8,6" PlaceholderText="Select page"
                                          Background="{DynamicResource Surface2Brush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                            </StackPanel>
                        </Grid>
                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0" Padding="0,16,0,0">
                            <StackPanel Spacing="12">
                                <CheckBox IsChecked="{Binding ConfirmDestructiveActions, Mode=TwoWay}"
                                          Content="Confirm destructive actions (Delete, End tenancy)"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                                <CheckBox IsChecked="{Binding AutoRefreshDashboard, Mode=TwoWay}"
                                          Content="Auto-refresh dashboard"
                                          Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- Sticky footer -->
        <Border Grid.Row="2" Classes="settings-footer">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Text="Save to apply changes." VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Button Content="Reset" Command="{Binding ResetCommand}"
                            Background="Transparent" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" Padding="14,10" CornerRadius="8"/>
                    <Button Content="Save" Command="{Binding SaveCommand}"
                            Background="{DynamicResource BrandPrimaryBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderThickness="0" Padding="14,10" CornerRadius="8"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
