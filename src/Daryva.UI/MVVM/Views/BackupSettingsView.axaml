<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Daryva.MVVM.Converters;assembly=Daryva"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="Daryva.MVVM.Views.BackupSettingsView"
             x:CompileBindings="False">
    <UserControl.Resources>
        <conv:IntToStringConverter x:Key="IntToStringConverter"/>
        <conv:BoolToConnectionStatusConverter x:Key="BoolToConnectionStatusConverter"/>
        <conv:DecimalToDatabaseSizeConverter x:Key="DecimalToDatabaseSizeConverter"/>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="0,0,0,24" Spacing="24">
            <!-- Header -->
            <TextBlock Text="Data &amp; Backup Settings"
                       FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <!-- Storage Information -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Padding="20,16">
                <StackPanel Spacing="20">
                    <TextBlock Text="Cloud Storage Information"
                               FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Backups in this section export cloud/API data to a JSON file."
                               FontSize="12"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Storage Type:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding DatabaseType, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 MinWidth="160"
                                 Padding="8,6"/>
                    </Grid>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Service Status:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding IsDatabaseConnected, Converter={StaticResource BoolToConnectionStatusConverter}, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 MinWidth="160"
                                 Padding="8,6"/>
                    </Grid>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Data Size:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding DatabaseSizeMB, Converter={StaticResource DecimalToDatabaseSizeConverter}, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 MinWidth="120"
                                 Padding="8,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Backup Settings -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Padding="20,16">
                <StackPanel Spacing="20">
                    <TextBlock Text="Backup Settings"
                               FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="To restore this JSON into another API instance, use the import endpoint on that target API."
                               FontSize="12"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,4"/>
                    <TextBlock IsVisible="{Binding CanBackupOrRestore, Converter={x:Static BoolConverters.Not}}"
                               Text="Select an organisation on the Organisation page before creating or restoring a backup."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Backup Location:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding BackupLocation, Mode=TwoWay}"
                                     MinWidth="280"
                                     Padding="8,6"/>
                            <Button Content="Browse..."
                                    Command="{Binding BrowseBackupLocationCommand}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
                        <Button Content="Backup Now"
                                Command="{Binding BackupNowCommand}"
                                IsEnabled="{Binding CanBackupOrRestore}"
                                Background="#FF9800"
                                Foreground="White"
                                BorderThickness="0"
                                Padding="16,8"
                                ToolTip.Tip="Export API data (houses, tenants, tenancies, payments, deposit returns) to a JSON file"/>
                        <Button Content="Restore Backup..."
                            Command="{Binding RestoreBackupCommand}"
                            IsEnabled="{Binding CanBackupOrRestore}"
                            Background="Transparent"
                            BorderBrush="{DynamicResource BorderBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"
                            BorderThickness="1"
                            Padding="16,8"
                            Margin="8,0,0,0"
                            ToolTip.Tip="Import a backup JSON file into the currently selected organisation"/>
                    </StackPanel>

                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding AutoBackupEnabled, Mode=TwoWay}"
                                  Content="Enable automatic backups"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Frequency:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding BackupFrequencyOptions}"
                                  SelectedItem="{Binding AutoBackupFrequency, Mode=TwoWay}"
                                  MinWidth="160"
                                  PlaceholderText="Select frequency"/>
                    </Grid>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Retention Policy:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding BackupRetentionCount, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"
                                     MinWidth="80"
                                     Padding="8,6"/>
                            <TextBlock Text="backups"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Content="Reset"
                        Command="{Binding ResetCommand}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
