<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:dgrid="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.DataGrid"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="760"
             x:Class="Daryva.MVVM.Views.HousesView"
             x:CompileBindings="False">
    <UserControl.Styles>
        <Style Selector="Border.command-bar">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="16"/>
        </Style>
        <Style Selector="Border.stat-pill">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,8"/>
        </Style>
        <Style Selector="Button.chip-btn">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="IsEnabled" Value="False"/>
        </Style>
        <Style Selector="CheckBox.active-chip">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
        </Style>
        <Style Selector="CheckBox.active-chip /template/ Border#checkBoxBorder">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="999"/>
            <Setter Property="Padding" Value="12,6"/>
        </Style>
        <Style Selector="CheckBox.active-chip:checked /template/ Border#checkBoxBorder">
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
            <Setter Property="Background" Value="#223152"/>
        </Style>
        <Style Selector="dgrid|DataGrid.premium-grid">
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="GridLinesVisibility" Value="Horizontal"/>
            <Setter Property="CanUserSortColumns" Value="True"/>
            <Setter Property="RowHeight" Value="48"/>
            <Setter Property="HeadersVisibility" Value="Column"/>
        </Style>
        <Style Selector="dgrid|DataGrid.premium-grid dgrid|DataGridColumnHeader">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="Foreground" Value="{DynamicResource TextMutedBrush}"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="dgrid|DataGrid.premium-grid dgrid|DataGridCell">
            <Setter Property="Padding" Value="10,8"/>
            <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
        </Style>
        <Style Selector="Button.house-action-btn">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="30"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="8"/>
        </Style>
        <Style Selector="Button.house-action-btn:pointerover">
            <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource BrandPrimaryBrush}"/>
        </Style>
        <Style Selector="dgrid|DataGrid.premium-grid dgrid|DataGridRow:pointerover">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        </Style>
        <Style Selector="dgrid|DataGrid.premium-grid dgrid|DataGridRow:selected">
            <Setter Property="Background" Value="#1A2A46"/>
        </Style>
    </UserControl.Styles>

    <Border Padding="24">
        <Grid RowDefinitions="Auto,Auto,Auto,*">
            <Border Grid.Row="0" Classes="command-bar">
                <Grid RowDefinitions="Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,14">
                        <StackPanel Grid.Column="0" Spacing="4" Margin="0,0,16,0">
                            <TextBlock Text="Houses" Classes="page-title"/>
                            <TextBlock Classes="text-muted" FontSize="13"
                                       Text="{Binding HouseCount, StringFormat='{}{0} houses • --/mo • -- tenants'}"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Top">
                            <Button Content="Add House" Classes="primary" Command="{Binding AddHouseCommand}"/>
                            <Button Content="Export" Classes="secondary" Command="{Binding ExportReportCommand}"/>
                            <Button Content="Refresh" Classes="secondary" Command="{Binding LoadHousesCommand}"/>
                            <Button Content="Remove" Command="{Binding RemoveHouseCommand}"/>
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="1" ColumnDefinitions="Auto,Auto,*">
                        <Grid Grid.Column="0" ColumnDefinitions="280,Auto" Margin="0,0,12,0">
                            <TextBox Grid.Column="0"
                                     Watermark="Search by name/address/city/postcode"
                                     Text="{Binding SearchTerm}"/>
                            <Button Grid.Column="1"
                                    Width="34"
                                    Margin="8,0,0,0"
                                    Classes="icon-button"
                                    Content="✕"
                                    Command="{Binding ClearSearchCommand}"/>
                        </Grid>

                        <WrapPanel Grid.Column="1" Orientation="Horizontal" Margin="0,0,12,0">
                            <CheckBox Classes="active-chip" Content="Active only" IsChecked="{Binding ShowActiveOnly}" Margin="0,0,8,0"/>
                            <Button Classes="chip-btn" Content="Has vacancies" Margin="0,0,8,0"/>
                            <Button Classes="chip-btn" Content="Overdue rent" Margin="0,0,8,0"/>
                            <Button Classes="chip-btn" Content="Docs expiring" Margin="0,0,8,0"/>
                            <Button Classes="chip-btn" Content="City"/>
                        </WrapPanel>
                    </Grid>
                </Grid>
            </Border>

            <WrapPanel Grid.Row="1" Orientation="Horizontal" Margin="0,16,0,0">
                <Border Classes="stat-pill" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Houses" Classes="text-muted" FontSize="12"/>
                        <TextBlock Text="{Binding HouseCount}" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Classes="stat-pill" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Rooms" Classes="text-muted" FontSize="12"/>
                        <TextBlock Text="{Binding TotalRooms}" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Classes="stat-pill" Margin="0,0,10,0">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Active Tenants" Classes="text-muted" FontSize="12"/>
                        <TextBlock Text="{Binding TotalActiveTenants}" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
                <Border Classes="stat-pill">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Monthly Rent" Classes="text-muted" FontSize="12"/>
                        <TextBlock Text="{Binding TotalMonthlyRent, StringFormat='£{0:N2}'}" FontWeight="Bold"/>
                    </StackPanel>
                </Border>
            </WrapPanel>

            <Border Grid.Row="2" Classes="command-bar" Margin="0,16,0,0" IsVisible="{Binding IsLoading}">
                <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Center">
                    <ProgressBar Width="220" IsIndeterminate="True"/>
                    <TextBlock Text="Loading houses..." Classes="text-muted" VerticalAlignment="Center"/>
                </StackPanel>
            </Border>

            <Grid Grid.Row="3" Margin="0,16,0,0">
                <Border Classes="command-bar" IsVisible="{Binding HasHouses}">
                    <Grid>
                        <dgrid:DataGrid Classes="premium-grid"
                                        ItemsSource="{Binding Houses}"
                                        SelectedItem="{Binding SelectedHouse}"
                                        IsReadOnly="True"
                                        AutoGenerateColumns="False"
                                        HorizontalAlignment="Stretch"
                                        VerticalAlignment="Stretch">
                            <dgrid:DataGrid.Columns>
                                <dgrid:DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="2*"/>
                                <dgrid:DataGridTextColumn Header="Address" Binding="{Binding AddressLine1}" Width="2*"/>
                                <dgrid:DataGridTextColumn Header="City" Binding="{Binding City}" Width="*"/>
                                <dgrid:DataGridTextColumn Header="Postcode" Binding="{Binding Postcode}" Width="*"/>
                                <dgrid:DataGridTemplateColumn Header="Rooms" Width="110">
                                    <dgrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalRooms}" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </dgrid:DataGridTemplateColumn.CellTemplate>
                                </dgrid:DataGridTemplateColumn>
                                <dgrid:DataGridTemplateColumn Header="Active Tenants" Width="170">
                                    <dgrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding ActiveTenantCount}" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </dgrid:DataGridTemplateColumn.CellTemplate>
                                </dgrid:DataGridTemplateColumn>
                                <dgrid:DataGridTemplateColumn Header="Monthly Rent" Width="140">
                                    <dgrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <TextBlock Text="{Binding TotalMonthlyRent, StringFormat='£{0:N2}'}" HorizontalAlignment="Right" TextAlignment="Right" VerticalAlignment="Center"/>
                                        </DataTemplate>
                                    </dgrid:DataGridTemplateColumn.CellTemplate>
                                </dgrid:DataGridTemplateColumn>
                                <dgrid:DataGridTemplateColumn Header="Actions" Width="170">
                                    <dgrid:DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Button Classes="house-action-btn" Content="⋯" IsEnabled="False">
                                                    <Button.ContextMenu>
                                                        <ContextMenu>
                                                            <MenuItem Header="View" IsEnabled="False"/>
                                                            <MenuItem Header="Edit" IsEnabled="False"/>
                                                            <MenuItem Header="Documents" IsEnabled="False"/>
                                                            <MenuItem Header="Record Payment" IsEnabled="False"/>
                                                        </ContextMenu>
                                                    </Button.ContextMenu>
                                                </Button>
                                                <Button Classes="house-action-btn" Content="✎" IsEnabled="False"/>
                                                <Button Classes="house-action-btn" Content="📄" IsEnabled="False"/>
                                                <Button Classes="house-action-btn" Content="£" IsEnabled="False"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </dgrid:DataGridTemplateColumn.CellTemplate>
                                </dgrid:DataGridTemplateColumn>
                            </dgrid:DataGrid.Columns>
                        </dgrid:DataGrid>
                    </Grid>
                </Border>

                <Border Classes="command-bar" IsVisible="{Binding HasHouses, Converter={x:Static BoolConverters.Not}}">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Spacing="10">
                        <TextBlock Text="🏠" FontSize="42" HorizontalAlignment="Center"/>
                        <TextBlock Text="No houses yet" Classes="section-title" HorizontalAlignment="Center"/>
                        <TextBlock Text="Add your first property to start tracking tenants, rent, and documents."
                                   Classes="text-muted"
                                   TextAlignment="Center"/>
                        <Button Content="Add House" Classes="primary" Command="{Binding AddHouseCommand}" HorizontalAlignment="Center"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Border>
</UserControl>
