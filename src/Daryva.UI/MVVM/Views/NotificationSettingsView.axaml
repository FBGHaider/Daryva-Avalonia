<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="Daryva.MVVM.Views.NotificationSettingsView"
             x:CompileBindings="False">
    <ScrollViewer>
        <StackPanel Margin="0,0,0,24" Spacing="24">
            <!-- Header -->
            <TextBlock Text="Notification Settings"
                       FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <!-- Sending Behavior -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Padding="20,16">
                <StackPanel Spacing="20">
                    <TextBlock Text="Sending Behavior"
                               FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Default Channel:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding NotificationChannelOptions}"
                                  SelectedItem="{Binding DefaultNotificationChannel, Mode=TwoWay}"
                                  MinWidth="160"
                                  PlaceholderText="Select channel"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Content="Reset"
                        Command="{Binding ResetCommand}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
