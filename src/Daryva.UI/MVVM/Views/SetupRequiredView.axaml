<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Daryva.MVVM.Converters"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Daryva.MVVM.Views.SetupRequiredView"
             x:CompileBindings="False">
    <UserControl.Resources>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
    </UserControl.Resources>
    <Border Padding="24" Background="{DynamicResource PrimaryBackgroundBrush}">
        <StackPanel Spacing="20" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Image Source="/Assets/Logo/Daryva_icon.ico"
                   Width="64"
                   Height="64"
                   HorizontalAlignment="Center"
                   Stretch="Uniform"/>
            <TextBlock Text="Complete your setup"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       HorizontalAlignment="Center"/>
            <TextBlock Text="{Binding SignedInWithText, FallbackValue='Signed in'}"
                       FontSize="14"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,8"/>

            <!-- Choose Org: user has orgs but must select one -->
            <StackPanel IsVisible="{Binding ShowChooseOrg}" Spacing="12">
                <TextBlock Text="Select an organisation to continue."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
                <ComboBox ItemsSource="{Binding OrganisationsList}"
                          SelectedItem="{Binding SelectedOrg}"
                          MinWidth="280"
                          HorizontalAlignment="Center"
                          PlaceholderText="Select organisation">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Name}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <Button Content="Continue"
                        Command="{Binding ContinueWithSelectedOrgCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InvertBoolConverter}}"
                        HorizontalAlignment="Center"
                        MinWidth="200"/>
            </StackPanel>

            <!-- Create Org: user has zero orgs -->
            <StackPanel IsVisible="{Binding ShowCreateOnly}" Spacing="12">
                <TextBlock Text="Create an organisation to get started, or restore one using a recovery code you saved earlier."
                           Foreground="{DynamicResource SecondaryTextBrush}"
                           TextWrapping="Wrap"
                           TextAlignment="Center"
                           HorizontalAlignment="Center"/>
                <Button Content="Create organisation"
                        Command="{Binding CreateOrganisationCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InvertBoolConverter}}"
                        HorizontalAlignment="Center"
                        MinWidth="200"/>
                <Button Content="Restore from recovery code…"
                        Command="{Binding RestoreFromCodeCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InvertBoolConverter}}"
                        HorizontalAlignment="Center"
                        MinWidth="200"/>
            </StackPanel>

            <StackPanel Spacing="12" HorizontalAlignment="Center">
                <Button Content="Open setup in browser"
                        Command="{Binding OpenOnboardingInBrowserCommand}"
                        HorizontalAlignment="Center"
                        MinWidth="200"/>
                <Button Content="Refresh"
                        Command="{Binding RefreshCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InvertBoolConverter}}"
                        HorizontalAlignment="Center"
                        MinWidth="120"/>
                <Button Content="Sign out"
                        Command="{Binding SignOutCommand}"
                        IsEnabled="{Binding IsRefreshing, Converter={StaticResource InvertBoolConverter}}"
                        HorizontalAlignment="Center"
                        MinWidth="120"
                        Background="{DynamicResource Surface2Brush}"
                        Foreground="{DynamicResource StatusDangerBrush}"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
