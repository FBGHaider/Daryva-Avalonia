<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="400"
             x:Class="Daryva.MVVM.Views.DatabaseSettingsView"
             x:CompileBindings="False">
    <ScrollViewer>
        <StackPanel Margin="0,0,0,24" Spacing="24">
            <TextBlock Text="API Connection"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <!-- Current API endpoint -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    Padding="20,16">
                <StackPanel Spacing="16">
                    <TextBlock Text="API endpoint"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>
                    <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto">
                        <TextBlock Text="Base URL:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding ApiBaseUrl, Mode=TwoWay}"
                                 Background="{DynamicResource ControlBackgroundHoverBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 Padding="8,6"
                                 TextWrapping="Wrap"/>

                        <TextBlock Grid.Row="1"
                                   Text="Connection:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,12,12,0"/>
                        <TextBox Grid.Row="1"
                                 Grid.Column="1"
                                 Text="{Binding ConnectionStatus, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="{DynamicResource ControlBackgroundHoverBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 Padding="8,6"
                                 Margin="0,12,0,0"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- API actions -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="API settings"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Set the API base URL for backend requests. Changes apply after app restart because API client is initialized at startup."
                               FontSize="12"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <StackPanel Orientation="Horizontal" Spacing="12">
                        <Button Content="Test connection"
                                Command="{Binding TestApiConnectionCommand}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderThickness="1"/>
                        <Button Content="Reset to default"
                                Command="{Binding ResetApiSettingsCommand}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderThickness="1"/>
                        <Button Content="Save API URL"
                                Command="{Binding SaveApiSettingsCommand}"
                                Background="Transparent"
                                BorderBrush="{DynamicResource BorderBrush}"
                                Foreground="{DynamicResource PrimaryTextBrush}"
                                BorderThickness="1"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Organization context -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    Padding="20,16">
                <StackPanel Spacing="12">
                    <TextBlock Text="Organization context"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Current org header (X-Org-Id):"
                               FontSize="12"
                               Foreground="{DynamicResource PrimaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>
                    <TextBox Text="{Binding CurrentOrganization, Mode=OneWay}"
                             IsReadOnly="True"
                             Background="{DynamicResource ControlBackgroundHoverBrush}"
                             Foreground="{DynamicResource PrimaryTextBrush}"
                             Padding="8,6"/>
                    <TextBlock Text="Use Data &amp; Backup to export/restore API data as JSON."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,8,0,0"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
