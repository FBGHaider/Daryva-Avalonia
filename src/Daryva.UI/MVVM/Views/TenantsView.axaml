<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Daryva.MVVM.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Daryva.MVVM.Views.TenantsView"
             x:CompileBindings="False">
    <UserControl.Resources>
        <converters:BoolToTitleConverter x:Key="BoolToTitleConverter"/>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:DateTimeToDisplayConverter x:Key="DateTimeToDisplayConverter"/>
    </UserControl.Resources>
    <Border Padding="16">
        <Grid RowDefinitions="Auto,Auto,*,Auto,*">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <TextBlock Text="Tenants" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"/>
                    <TextBlock Text="{Binding ShowArchivedOnly, Converter={StaticResource BoolToTitleConverter}, ConverterParameter='Leave|Active Tenants'}" 
                               FontSize="16" 
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               VerticalAlignment="Center"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" HorizontalAlignment="Right">
                    <Button Content="{Binding ShowArchivedOnly, Converter={StaticResource BoolToTitleConverter}, ConverterParameter='View Active|View Leave'}" 
                            Command="{Binding ViewArchivedCommand}"
                            Background="{DynamicResource ControlBackgroundBrush}"
                            Foreground="{DynamicResource PrimaryTextBrush}"/>
                    <Button Content="Add Tenant" 
                            Command="{Binding AddTenantCommand}"
                            IsVisible="{Binding ShowArchivedOnly, Converter={StaticResource InvertBoolConverter}}"/>
                    <Button Content="Edit Tenant" 
                            Command="{Binding EditTenantCommand}"
                            IsVisible="{Binding ShowArchivedOnly, Converter={StaticResource InvertBoolConverter}}"/>
                    <Button Content="Mark as leave" 
                            Command="{Binding RemoveTenantCommand}"
                            IsVisible="{Binding ShowArchivedOnly, Converter={StaticResource InvertBoolConverter}}"/>
                    <Button Content="Recover" 
                            Command="{Binding RecoverTenantCommand}"
                            Background="{DynamicResource AccentBrush}"
                            Foreground="White"
                            IsVisible="{Binding ShowArchivedOnly}"/>
                    <Button Content="Delete Permanently" 
                            Command="{Binding DeleteArchivedCommand}"
                            Background="#DC3545"
                            Foreground="White"
                            IsVisible="{Binding ShowArchivedOnly}"/>
                    <Button Content="Refresh" Command="{Binding LoadTenantsCommand}"/>
                </StackPanel>
            </Grid>

            <!-- Filter and Search -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,16,0,16">
                <TextBlock Text="House:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,6,0"/>
                <ComboBox ItemsSource="{Binding HouseFilterOptions}"
                          SelectedItem="{Binding SelectedHouseFilter}"
                          MinWidth="220"
                          PlaceholderText="All tenants">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Display}" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                <TextBox Width="260"
                         Watermark="Search by name/email/phone"
                         Text="{Binding SearchTerm}"/>
            </StackPanel>

            <!-- Tenants Table -->
            <Border Grid.Row="2" BorderThickness="1" CornerRadius="6" Padding="8" Background="{DynamicResource SecondaryBackgroundBrush}">
                <Grid RowDefinitions="Auto,*" ColumnDefinitions="*">
                    <!-- Header Row -->
                    <Border Grid.Row="0" 
                            Background="{DynamicResource TableHeaderBackgroundBrush}" 
                            BorderBrush="{DynamicResource BorderBrush}" 
                            BorderThickness="0,0,0,1"
                            Padding="8,10">
                        <Grid ColumnDefinitions="200,250,150,200,*,120">
                            <TextBlock Grid.Column="0" Text="Name" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="Email" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="2" Text="Phone" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="3" Text="University" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="4" Text="Current House" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="5" Text="Leave date" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}" IsVisible="{Binding ShowArchivedOnly}"/>
                        </Grid>
                    </Border>
                    
                    <!-- Data Rows -->
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto">
                        <ListBox ItemsSource="{Binding Tenants}"
                                 SelectedItem="{Binding SelectedTenant}"
                                 SelectionMode="Single"
                                 Background="{DynamicResource SecondaryBackgroundBrush}"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" 
                                            BorderThickness="0,0,0,1"
                                            Padding="8,8"
                                            Background="Transparent"
                                            Cursor="Hand">
                                        <Grid ColumnDefinitions="200,250,150,200,*,120">
                                            <TextBlock Grid.Column="0" Text="{Binding FullName}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding Email}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding PhoneNumber}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding UniversityName}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding CurrentHouseAddress}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding LeaveDate, Converter={StaticResource DateTimeToDisplayConverter}, ConverterParameter=date}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" IsVisible="{Binding DataContext.ShowArchivedOnly, RelativeSource={RelativeSource AncestorType=UserControl}}"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Background" Value="{DynamicResource TableRowEvenBackgroundBrush}"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHoverBrush}"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Deposit returns table (Leave tab only) -->
            <TextBlock Grid.Row="3" Text="Deposit returns pending" FontSize="16" FontWeight="Bold" Margin="0,20,0,8"
                       Foreground="{DynamicResource PrimaryTextBrush}"
                       IsVisible="{Binding ShowArchivedOnly}"/>
            <Border Grid.Row="4" BorderThickness="1" CornerRadius="6" Padding="8" Background="{DynamicResource SecondaryBackgroundBrush}"
                    IsVisible="{Binding ShowArchivedOnly}">
                <Grid RowDefinitions="Auto,*">
                    <Border Grid.Row="0" Background="{DynamicResource TableHeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,10">
                        <Grid ColumnDefinitions="180,220,120,120,*">
                            <TextBlock Grid.Column="0" Text="Tenant" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="1" Text="House" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="2" Text="Leave date" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="3" Text="Amount to return" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                            <TextBlock Grid.Column="4" Text="Actions" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" MaxHeight="220">
                        <ListBox ItemsSource="{Binding DepositReturnList}" Background="Transparent" BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="8,8">
                                        <Grid ColumnDefinitions="180,220,120,120,*">
                                            <TextBlock Grid.Column="0" Text="{Binding TenantName}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="1" Text="{Binding HouseAddress}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="2" Text="{Binding LeaveDateDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="3" Text="{Binding AmountToReturn, StringFormat='£{0:N2}'}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <Button Grid.Column="4" Content="Record returned"
                                                    Command="{Binding DataContext.RecordDepositReturnedCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}"
                                                    HorizontalAlignment="Left" Padding="12,6"/>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Background" Value="{DynamicResource TableRowEvenBackgroundBrush}"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHoverBrush}"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
