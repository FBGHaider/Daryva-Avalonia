<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Daryva.MVVM.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Daryva.MVVM.Converters"
        xmlns:controls="clr-namespace:Daryva.MVVM.Views.Controls"
        xmlns:materialIcons="using:Material.Icons.Avalonia"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Daryva.MVVM.Views.MainWindow"
        x:CompileBindings="False"
        Title="Daryva"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:BoolToWidthConverter x:Key="BoolToWidthConverter"/>
        <converters:BoolToChevronConverter x:Key="BoolToChevronConverter"/>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter"/>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="ListBox#NavigationList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Name="NavBorder" Background="Transparent" CornerRadius="8" Margin="6,2,6,2">
                        <Grid ColumnDefinitions="3,*">
                            <Border Name="ActiveIndicator" Grid.Column="0" Background="Transparent" CornerRadius="2"/>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="0"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox#NavigationList ListBoxItem:selected /template/ Border#NavBorder">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        </Style>
        <Style Selector="ListBox#NavigationList ListBoxItem:selected /template/ Border#ActiveIndicator">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox#NavigationList ListBoxItem:pointerover /template/ Border#NavBorder">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundHoverBrush}"/>
        </Style>
        <!-- Active nav item's icon picks up the brand accent too, not just the indicator stripe. -->
        <Style Selector="ListBox#NavigationList ListBoxItem:selected materialIcons|MaterialIcon">
            <Setter Property="Foreground" Value="{DynamicResource BrandPrimaryBrush}"/>
        </Style>
        <Style Selector="Border#SupportSessionRootBorder.support-session-active">
            <Setter Property="BorderBrush" Value="#E5484D"/>
            <Setter Property="BorderThickness" Value="4"/>
        </Style>
    </Window.Styles>
    <Border x:Name="SupportSessionRootBorder" BorderThickness="0" Classes.support-session-active="{Binding IsInSupportSession}">
    <DockPanel>
        <!-- Live support session banner: always visible while acting inside another org's data via
             Support Mode, from any tab, not just the Support Mode screen itself. -->
        <Border DockPanel.Dock="Top" Background="#E5484D" Padding="14,8" IsVisible="{Binding IsInSupportSession}">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock Grid.Column="0" Foreground="White" VerticalAlignment="Center" FontWeight="SemiBold" FontSize="13">
                    <Run Text="🔴 Live support session on "/>
                    <Run Text="{Binding SupportSessionOrgName}" FontWeight="Bold"/>
                    <Run Text=" — expires "/>
                    <Run Text="{Binding SupportSessionExpiresDisplay}"/>
                </TextBlock>
                <Button Grid.Column="1" Content="End session" Command="{Binding EndActiveSupportSessionCommand}"
                        Background="White" Foreground="#E5484D" BorderThickness="0" Padding="12,6" CornerRadius="6" Cursor="Hand"/>
            </Grid>
        </Border>

    <Grid x:Name="MainGrid" RowDefinitions="*" Background="{DynamicResource PrimaryBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding NavigationColumnWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Rail -->
        <Border Grid.Row="0" Grid.Column="0" 
                Background="{DynamicResource NavigationBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,1,0"
                IsVisible="{Binding IsOnboardingMode, Converter={StaticResource InvertBoolConverter}}">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- App Title -->
                  <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="16,16,16,20"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsNavigationCollapsed, Converter={StaticResource InvertBoolConverter}}">
                      <Image Source="/Assets/Logo/Daryva_icon.ico"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"
                          VerticalAlignment="Center"/>
                      <TextBlock Text="Daryva"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          VerticalAlignment="Center"/>
                  </StackPanel>
                
                <!-- Navigation Items -->
                <ListBox Grid.Row="1"
                    x:Name="NavigationList"
                        ItemsSource="{Binding NavigationItems}"
                        SelectedItem="{Binding SelectedNavigationItem}"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionMode="Single"
                        Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" 
                                      Margin="10,10"
                                      Spacing="12"
                                      HorizontalAlignment="{Binding DataContext.IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToAlignmentConverter}}">
                                <materialIcons:MaterialIcon Kind="{Binding Icon}"
                                          Width="20" Height="20"
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Title}" 
                                          FontSize="14" 
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          IsVisible="{Binding DataContext.IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertBoolConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer Actions -->
                <StackPanel Grid.Row="2" Margin="8,8,8,8" Spacing="8">
                    <controls:SidebarProfileFooter DataContext="{Binding}"/>

                        <Button Command="{Binding ToggleNavigationCommand}"
                            HorizontalAlignment="Left"
                            Padding="4"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock Text="{Binding IsNavigationCollapsed, Converter={StaticResource BoolToChevronConverter}}" 
                                  FontSize="12"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area (normal app mode) -->
        <ContentControl Grid.Row="0" Grid.Column="1"
                       Content="{Binding CurrentViewModel}"
                       Background="{DynamicResource PrimaryBackgroundBrush}"
                       Margin="0"
                       IsVisible="{Binding IsOnboardingMode, Converter={StaticResource InvertBoolConverter}}"/>

        <!-- Onboarding Content Area (full width) -->
        <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Content="{Binding CurrentViewModel}"
                       Background="{DynamicResource PrimaryBackgroundBrush}"
                       Margin="0"
                       IsVisible="{Binding IsOnboardingMode}"/>
    </Grid>
    </DockPanel>
    </Border>
</Window>
