<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Daryva.MVVM.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:converters="clr-namespace:Daryva.MVVM.Converters"
        mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
        x:Class="Daryva.MVVM.Views.MainWindow"
        x:CompileBindings="False"
        Title="Daryva"
        Width="1200" Height="800"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <converters:BoolToWidthConverter x:Key="BoolToWidthConverter"/>
        <converters:BoolToChevronConverter x:Key="BoolToChevronConverter"/>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
        <converters:BoolToAlignmentConverter x:Key="BoolToAlignmentConverter"/>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="ListBox#NavigationList ListBoxItem">
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <ControlTemplate TargetType="ListBoxItem">
                    <Border Name="NavBorder" Background="Transparent" CornerRadius="8" Margin="6,2,6,2">
                        <Grid ColumnDefinitions="3,*">
                            <Border Name="ActiveIndicator" Grid.Column="0" Background="Transparent" CornerRadius="2"/>
                            <ContentPresenter Grid.Column="1"
                                              Content="{TemplateBinding Content}"
                                              ContentTemplate="{TemplateBinding ContentTemplate}"
                                              Margin="0"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Center"/>
                        </Grid>
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ListBox#NavigationList ListBoxItem:selected /template/ Border#NavBorder">
            <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
        </Style>
        <Style Selector="ListBox#NavigationList ListBoxItem:selected /template/ Border#ActiveIndicator">
            <Setter Property="Background" Value="{DynamicResource BrandPrimaryBrush}"/>
        </Style>
        <Style Selector="ListBox#NavigationList ListBoxItem:pointerover /template/ Border#NavBorder">
            <Setter Property="Background" Value="{DynamicResource ControlBackgroundHoverBrush}"/>
        </Style>
    </Window.Styles>
    <Grid x:Name="MainGrid" RowDefinitions="*" Background="{DynamicResource PrimaryBackgroundBrush}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="{Binding NavigationColumnWidth}"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        
        <!-- Left Navigation Rail -->
        <Border Grid.Row="0" Grid.Column="0" 
                Background="{DynamicResource NavigationBackgroundBrush}" 
                BorderBrush="{DynamicResource BorderBrush}" 
                BorderThickness="0,0,1,0"
                IsVisible="{Binding IsOnboardingMode, Converter={StaticResource InvertBoolConverter}}">
            <Grid RowDefinitions="Auto,*,Auto">
                <!-- App Title -->
                  <StackPanel Grid.Row="0"
                        Orientation="Horizontal"
                        Spacing="8"
                        Margin="16,16,16,20"
                        VerticalAlignment="Center"
                        IsVisible="{Binding IsNavigationCollapsed, Converter={StaticResource InvertBoolConverter}}">
                      <Image Source="/Assets/Logo/Daryva_icon.ico"
                          Width="20"
                          Height="20"
                          Stretch="Uniform"
                          VerticalAlignment="Center"/>
                      <TextBlock Text="Daryva"
                          FontSize="20"
                          FontWeight="SemiBold"
                          Foreground="{DynamicResource PrimaryTextBrush}"
                          VerticalAlignment="Center"/>
                  </StackPanel>
                
                <!-- Navigation Items -->
                <ListBox Grid.Row="1"
                    x:Name="NavigationList"
                        ItemsSource="{Binding NavigationItems}"
                        SelectedItem="{Binding SelectedNavigationItem}"
                        Background="Transparent"
                        BorderThickness="0"
                        SelectionMode="Single"
                        Margin="0,0,0,8">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" 
                                      Margin="10,10"
                                      Spacing="12"
                                      HorizontalAlignment="{Binding DataContext.IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToAlignmentConverter}}">
                                <TextBlock Text="{Binding Icon}" 
                                          FontSize="18" 
                                          VerticalAlignment="Center"
                                          Opacity="0.85"
                                          Foreground="{DynamicResource TextMutedBrush}"/>
                                <TextBlock Text="{Binding Title}" 
                                          FontSize="14" 
                                          VerticalAlignment="Center"
                                          Foreground="{DynamicResource TextPrimaryBrush}"
                                          IsVisible="{Binding DataContext.IsNavigationCollapsed, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource InvertBoolConverter}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Footer Actions -->
                <StackPanel Grid.Row="2" Margin="8,8,8,8" Spacing="8">
                    <Border Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="8,6"
                            IsVisible="{Binding IsNavigationCollapsed, Converter={StaticResource InvertBoolConverter}}">
                        <StackPanel Spacing="2">
                            <TextBlock Text="Organization"
                                      FontSize="11"
                                      Opacity="0.7"/>
                            <TextBlock Text="{Binding CurrentOrganizationName}"
                                      FontSize="13"
                                      FontWeight="SemiBold"
                                      TextTrimming="CharacterEllipsis"
                                      MaxWidth="170"/>
                        </StackPanel>
                    </Border>

                    <Button Command="{Binding SwitchOrganizationCommand}"
                            HorizontalAlignment="Stretch"
                            Padding="8,6"
                            Background="{DynamicResource Surface2Brush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Cursor="Hand">
                        <StackPanel Orientation="Horizontal" Spacing="8"
                                    HorizontalAlignment="{Binding IsNavigationCollapsed, Converter={StaticResource BoolToAlignmentConverter}}">
                            <TextBlock Text="🏢" FontSize="14" VerticalAlignment="Center"/>
                            <TextBlock Text="Switch Org"
                                      IsVisible="{Binding IsNavigationCollapsed, Converter={StaticResource InvertBoolConverter}}"
                                      VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>

                        <Button Command="{Binding ToggleNavigationCommand}"
                            HorizontalAlignment="Left"
                            Padding="4"
                            Width="24"
                            Height="24"
                            Background="Transparent"
                            BorderThickness="0"
                            Cursor="Hand">
                        <TextBlock Text="{Binding IsNavigationCollapsed, Converter={StaticResource BoolToChevronConverter}}" 
                                  FontSize="12"
                                  Foreground="{DynamicResource PrimaryTextBrush}"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"/>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Content Area (normal app mode) -->
        <ContentControl Grid.Row="0" Grid.Column="1"
                       Content="{Binding CurrentViewModel}"
                       Background="{DynamicResource PrimaryBackgroundBrush}"
                       Margin="0"
                       IsVisible="{Binding IsOnboardingMode, Converter={StaticResource InvertBoolConverter}}"/>

        <!-- Onboarding Content Area (full width) -->
        <ContentControl Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2"
                       Content="{Binding CurrentViewModel}"
                       Background="{DynamicResource PrimaryBackgroundBrush}"
                       Margin="0"
                       IsVisible="{Binding IsOnboardingMode}"/>
    </Grid>
</Window>
