<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Daryva.MVVM.Converters"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Daryva.MVVM.Views.DocumentsView"
             x:CompileBindings="False"
             x:Name="Root">
    <UserControl.Resources>
        <converters:DateTimeToDisplayConverter x:Key="DateTimeToDisplayConverter"/>
    </UserControl.Resources>
    <Border Padding="16">
        <Grid RowDefinitions="Auto,Auto,*">
            <!-- Header -->
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                <TextBlock Grid.Column="0" Text="Documents" FontSize="22" FontWeight="Bold" VerticalAlignment="Center"
                           Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,0,12"/>
                <Button Grid.Column="1" Content="Upload" Command="{Binding UploadDocumentCommand}"
                        VerticalAlignment="Center" Margin="0,0,0,12"/>
            </Grid>

            <!-- Filter: Search -->
            <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="12" Margin="0,0,0,10">
                <TextBlock Text="Search:" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,4,0"/>
                <TextBox Width="280" Watermark="Search by type, tenant, file name..." Text="{Binding SearchTerm}"/>
            </StackPanel>

            <!-- Documents table -->
            <Border Grid.Row="2" BorderThickness="1" CornerRadius="6" Padding="8" Background="{DynamicResource SecondaryBackgroundBrush}">
                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                    <Grid RowDefinitions="Auto,*" ColumnDefinitions="*" MinWidth="1000">
                                <Border Grid.Row="0"
                                        Background="{DynamicResource TableHeaderBackgroundBrush}"
                                        BorderBrush="{DynamicResource BorderBrush}"
                                        BorderThickness="0,0,0,1"
                                        Padding="8,10">
                                    <Grid ColumnDefinitions="120,160,220,100,100,60,80,180">
                                        <TextBlock Grid.Column="0" Text="Type" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Grid.Column="1" Text="Tenant / House" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Grid.Column="2" Text="File Name" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Grid.Column="3" Text="Uploaded" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Grid.Column="4" Text="Valid To" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Grid.Column="5" Text="Version" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Grid.Column="6" Text="Source" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                        <TextBlock Grid.Column="7" Text="Actions" FontWeight="Bold" FontSize="14" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                    </Grid>
                                </Border>

                        <ListBox Grid.Row="1"
                                 ItemsSource="{Binding Documents}"
                                 SelectedItem="{Binding SelectedDocument}"
                                 SelectionMode="Single"
                                 Background="{DynamicResource SecondaryBackgroundBrush}"
                                 BorderThickness="0">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="0,0,0,1"
                                            Padding="8,8"
                                            Background="Transparent"
                                            Cursor="Hand">
                                        <Grid ColumnDefinitions="120,160,220,100,100,60,80,180">
                                            <TextBlock Grid.Column="0" Text="{Binding DisplayName}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="1" Text="{Binding TenantOrHouseDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="2" Text="{Binding FileName}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" TextTrimming="CharacterEllipsis"/>
                                            <TextBlock Grid.Column="3" Text="{Binding UploadedAt, Converter={StaticResource DateTimeToDisplayConverter}, ConverterParameter=date}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="4" Text="{Binding ValidTo, Converter={StaticResource DateTimeToDisplayConverter}, ConverterParameter=date}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="5" Text="{Binding Version}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <TextBlock Grid.Column="6" Text="{Binding Source}" VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}"/>
                                            <StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="4">
                                                <Button Content="View" Command="{Binding DataContext.ViewDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Padding="6,2" FontSize="11"/>
                                                <Button Content="Download" Command="{Binding DataContext.DownloadDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Padding="6,2" FontSize="11"/>
                                                <Button Content="Delete" Command="{Binding DataContext.DeleteDocumentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Padding="6,2" FontSize="11"/>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                            <ListBox.Styles>
                                <Style Selector="ListBoxItem">
                                    <Setter Property="Background" Value="{DynamicResource TableRowEvenBackgroundBrush}"/>
                                    <Setter Property="Padding" Value="0"/>
                                </Style>
                                <Style Selector="ListBoxItem:selected">
                                    <Setter Property="Background" Value="{DynamicResource AccentBrush}"/>
                                </Style>
                                <Style Selector="ListBoxItem:pointerover">
                                    <Setter Property="Background" Value="{DynamicResource ControlBackgroundHoverBrush}"/>
                                </Style>
                            </ListBox.Styles>
                        </ListBox>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</UserControl>
