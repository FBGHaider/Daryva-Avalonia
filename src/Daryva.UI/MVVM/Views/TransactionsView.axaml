<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Daryva.MVVM.Views.TransactionsView"
             x:CompileBindings="False">
    <Border Padding="12">
        <Grid RowDefinitions="Auto,Auto,Auto,Auto,Auto,*">
            <!-- Compact filters -->
            <Border Grid.Row="0" Background="{DynamicResource Surface2Brush}" BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="10">
                    <ComboBox Width="130" ItemsSource="{Binding DateRangeFilterOptions}" SelectedItem="{Binding DateRangeFilter}"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <ComboBox Width="160" ItemsSource="{Binding Houses}" SelectedValue="{Binding SelectedHouseId}"
                              SelectedValueBinding="{Binding HouseId}"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding AddressLine1}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Width="160" ItemsSource="{Binding Tenants}" SelectedValue="{Binding SelectedTenantId}"
                              SelectedValueBinding="{Binding TenantId}"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding FullName}" Foreground="{DynamicResource TextPrimaryBrush}"/>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                    <ComboBox Width="100" ItemsSource="{Binding PaymentTypeFilterOptions}" SelectedItem="{Binding PaymentTypeFilter}"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <ComboBox Width="120" ItemsSource="{Binding MethodFilterOptions}" SelectedItem="{Binding MethodFilter}"
                              Background="{DynamicResource SurfaceBrush}" Foreground="{DynamicResource TextPrimaryBrush}" BorderBrush="{DynamicResource BorderBrush}"/>
                    <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}"
                            Background="Transparent" Foreground="{DynamicResource TextMutedBrush}" BorderThickness="0"
                            Padding="8,4" FontSize="12"/>
                </StackPanel>
            </Border>

            <!-- KPI strip -->
            <Border Grid.Row="1" Background="Transparent" Margin="0,0,0,10">
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Transactions" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TransactionCount}" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="12,8" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Text="Collected" Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                            <TextBlock Text="{Binding TotalCollectedSum, StringFormat='£{0:N2}'}"
                                       Foreground="{DynamicResource TextPrimaryBrush}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Border>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="999" Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center">
                            <Run Text="Bank Transfer: "/><Run Text="{Binding BankTransferCount}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="999" Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center">
                            <Run Text="Cash: "/><Run Text="{Binding CashCount}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </TextBlock>
                    </Border>
                    <Border Background="{DynamicResource Surface2Brush}" CornerRadius="999" Padding="8,4" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1">
                        <TextBlock Foreground="{DynamicResource TextMutedBrush}" FontSize="12" VerticalAlignment="Center">
                            <Run Text="Other: "/><Run Text="{Binding OtherMethodCount}" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}"/>
                        </TextBlock>
                    </Border>
                </StackPanel>
            </Border>

            <!-- Rent Transactions -->
            <TextBlock Grid.Row="2" Text="Rent Transactions" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

            <Border Grid.Row="3" BorderThickness="1" CornerRadius="8" Padding="0" Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,16">
                <Grid RowDefinitions="Auto,*" MinHeight="120">
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="8,10">
                        <Grid ColumnDefinitions="100,200,240,100,100,120,100,120,120">
                            <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="Tenant" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="House" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="Period" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="4" Text="Amount" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="5" Text="Collected By" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="6" Text="Method" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="7" Text="Reference" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="8" Text="Actions" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                        <Grid MinWidth="1220">
                            <ListBox ItemsSource="{Binding RentTransactions}" SelectedItem="{Binding SelectedTransaction}"
                                     SelectionMode="Single" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="8,8" Background="Transparent" Cursor="Hand">
                                            <Grid ColumnDefinitions="100,200,240,100,100,120,100,120,80">
                                                <TextBlock Grid.Column="0" Text="{Binding PaidOnDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TenantName}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                                <TextBlock Grid.Column="2" Text="{Binding HouseAddress}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                                <TextBlock Grid.Column="3" Text="{Binding PeriodLabel}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <TextBlock Grid.Column="4" Text="{Binding Amount, StringFormat='£{0:N2}'}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <TextBlock Grid.Column="5" Text="{Binding CollectedBy}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <TextBlock Grid.Column="6" Text="{Binding Method}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <TextBlock Grid.Column="7" Text="{Binding Reference}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <Button Grid.Column="8" Content="↩" ToolTip.Tip="Unrecord payment"
                                                        Command="{Binding DataContext.UnrecordPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="32" Height="28" Padding="0" FontSize="14"
                                                        Background="Transparent" Foreground="{DynamicResource StatusDangerBrush}"
                                                        BorderThickness="0" CornerRadius="6"
                                                        Classes="unrecord-btn"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                    </Style>
                                    <Style Selector="Button.unrecord-btn:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource StatusDangerBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                            <Border IsVisible="{Binding HasRentTransactions, Converter={x:Static BoolConverters.Not}}"
                                    Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="12">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock Text="No rent transactions for this period" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Try changing date range or clear filters." Foreground="{DynamicResource TextMutedBrush}" FontSize="13" HorizontalAlignment="Center"/>
                                    <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center"
                                            Background="Transparent" Foreground="{DynamicResource BrandPrimaryBrush}" BorderThickness="0" Padding="8,6"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!-- Deposit Transactions -->
            <TextBlock Grid.Row="4" Text="Deposit Transactions" FontSize="16" FontWeight="SemiBold"
                       Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,8"/>

            <Border Grid.Row="5" BorderThickness="1" CornerRadius="8" Padding="0" Background="{DynamicResource Surface2Brush}"
                    BorderBrush="{DynamicResource BorderBrush}" Margin="0,0,0,0">
                <Grid RowDefinitions="Auto,*" MinHeight="120">
                    <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="0,0,0,1" Padding="8,10">
                        <Grid ColumnDefinitions="100,200,240,100,120,100,120,100">
                            <TextBlock Grid.Column="0" Text="Date" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="1" Text="Tenant" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="2" Text="House" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="3" Text="Amount" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="4" Text="Collected By" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="5" Text="Method" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="6" Text="Reference" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                            <TextBlock Grid.Column="7" Text="Actions" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextMutedBrush}"/>
                        </Grid>
                    </Border>
                    <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" MaxHeight="400">
                        <Grid MinWidth="1030">
                            <ListBox ItemsSource="{Binding DepositTransactions}" SelectedItem="{Binding SelectedTransaction}"
                                     SelectionMode="Single" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Border BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1"
                                                Padding="8,8" Background="Transparent" Cursor="Hand">
                                            <Grid ColumnDefinitions="100,200,240,100,120,100,120,80">
                                                <TextBlock Grid.Column="0" Text="{Binding PaidOnDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <TextBlock Grid.Column="1" Text="{Binding TenantName}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                                <TextBlock Grid.Column="2" Text="{Binding HouseAddress}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" TextTrimming="CharacterEllipsis" FontSize="13"/>
                                                <TextBlock Grid.Column="3" Text="{Binding Amount, StringFormat='£{0:N2}'}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <TextBlock Grid.Column="4" Text="{Binding CollectedBy}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <TextBlock Grid.Column="5" Text="{Binding Method}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <TextBlock Grid.Column="6" Text="{Binding Reference}" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" FontSize="13"/>
                                                <Button Grid.Column="7" Content="↩" ToolTip.Tip="Unrecord payment"
                                                        Command="{Binding DataContext.UnrecordPaymentCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}"
                                                        Width="32" Height="28" Padding="0" FontSize="14"
                                                        Background="Transparent" Foreground="{DynamicResource StatusDangerBrush}"
                                                        BorderThickness="0" CornerRadius="6"
                                                        Classes="unrecord-btn"/>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                                <ListBox.Styles>
                                    <Style Selector="ListBoxItem">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="Padding" Value="0"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:selected">
                                        <Setter Property="Background" Value="{DynamicResource SurfaceBrush}"/>
                                    </Style>
                                    <Style Selector="ListBoxItem:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource Surface2Brush}"/>
                                    </Style>
                                    <Style Selector="Button.unrecord-btn:pointerover">
                                        <Setter Property="Background" Value="{DynamicResource StatusDangerBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}"/>
                                    </Style>
                                </ListBox.Styles>
                            </ListBox>
                            <Border IsVisible="{Binding HasDepositTransactions, Converter={x:Static ObjectConverters.IsNull}}"
                                    Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="24" VerticalAlignment="Center" HorizontalAlignment="Stretch" Margin="12">
                                <StackPanel HorizontalAlignment="Center" Spacing="8">
                                    <TextBlock Text="No deposit transactions for this period" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Center"/>
                                    <TextBlock Text="Try changing date range or clear filters." Foreground="{DynamicResource TextMutedBrush}" FontSize="13" HorizontalAlignment="Center"/>
                                    <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" HorizontalAlignment="Center"
                                            Background="Transparent" Foreground="{DynamicResource BrandPrimaryBrush}" BorderThickness="0" Padding="8,6"/>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
