# Copy this file on the VPS to .env (DO NOT COMMIT .env)
# docker compose automatically loads .env from the same folder as docker-compose.prod.yml

# API image (set by GitHub Action during deploy, fallback shown)
DARYVA_API_IMAGE=ghcr.io/your-org/daryva-api:latest

# API + auth
API_CONNECTION_STRING=Host=postgres;Port=5432;Database=daryva;Username=daryva;Password=CHANGE_ME_STRONG
JWT_SIGNING_KEY=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32

# SMTP
SMTP_SERVER=smtp.resend.com
SMTP_PORT=587
SMTP_USERNAME=resend
SMTP_PASSWORD=CHANGE_ME_SMTP_SECRET
SMTP_ENABLE_SSL=true
SMTP_FROM_ADDRESS=no-reply@daryva.com

# Postgres container
POSTGRES_DB=daryva
POSTGRES_USER=daryva
POSTGRES_PASSWORD=CHANGE_ME_POSTGRES_PASSWORD
