# Clerk (app.daryva.com auth)
# Get keys from https://dashboard.clerk.com
# Copy this file to .env.local and fill in your keys (do not rename; keep this file as the template).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_your_publishable_key
CLERK_SECRET_KEY=sk_test_your_secret_key

# Daryva API (JWT validated; set API Jwt:Authority to your Clerk issuer when using Clerk)
NEXT_PUBLIC_API_URL=http://localhost:5000
