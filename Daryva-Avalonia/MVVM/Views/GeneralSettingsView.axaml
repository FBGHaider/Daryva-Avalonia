<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:converters="clr-namespace:Daryva.MVVM.Converters;assembly=Daryva"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="500"
             x:Class="Daryva.MVVM.Views.GeneralSettingsView"
             x:CompileBindings="False">
    <UserControl.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <converters:InvertBoolConverter x:Key="InvertBoolConverter"/>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="0,0,0,24" Spacing="24">
            <!-- Header -->
            <TextBlock Text="General Settings"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="{DynamicResource PrimaryTextBrush}"/>

            <!-- Appearance & Behavior -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    Padding="20,16">
                <StackPanel Spacing="20">
                    <TextBlock Text="Appearance &amp; Behavior"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>

                    <!-- Currency -->
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto">
                        <TextBlock Text="Currency:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2">
                            <TextBox Text="{Binding Currency, Mode=TwoWay}"
                                     MinWidth="120"
                                     Padding="8,6"
                                     Watermark="e.g. GBP, £, USD"/>
                            <TextBlock Text="Used in notifications (e.g. {Currency}{AmountDue}). Codes: GBP, USD, EUR, INR, PKR; or symbol £, $, €, Rs."
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <!-- Date Format -->
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto">
                        <TextBlock Text="Date Format:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding DateFormatOptions}"
                                  SelectedItem="{Binding DateFormat, Mode=TwoWay}"
                                  MinWidth="200"
                                  PlaceholderText="Select format"/>
                    </Grid>

                    <!-- Time Zone -->
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto">
                        <TextBlock Text="Time Zone:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding TimeZone, Mode=TwoWay}"
                                 IsReadOnly="True"
                                 Background="{DynamicResource ControlBackgroundHoverBrush}"
                                 Foreground="{DynamicResource PrimaryTextBrush}"
                                 MinWidth="220"
                                 Padding="8,6"/>
                    </Grid>

                    <!-- App Start Page -->
                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto">
                        <TextBlock Text="App Start Page:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding AppStartPageOptions}"
                                  SelectedItem="{Binding AppStartPage, Mode=TwoWay}"
                                  MinWidth="200"
                                  PlaceholderText="Select page"/>
                    </Grid>

                    <!-- Checkboxes -->
                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding ConfirmDestructiveActions, Mode=TwoWay}"
                                  Content="Confirm destructive actions (Delete, End tenancy)"
                                  Foreground="{DynamicResource PrimaryTextBrush}"/>
                        <CheckBox IsChecked="{Binding AutoRefreshDashboard, Mode=TwoWay}"
                                  Content="Auto-refresh dashboard"
                                  Foreground="{DynamicResource PrimaryTextBrush}"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Updates (Velopack) -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource ControlBackgroundBrush}"
                    Padding="20,16"
                    IsVisible="{Binding IsUpdateCheckAvailable}">
                <StackPanel Spacing="16">
                    <TextBlock Text="Updates"
                               FontSize="13"
                               FontWeight="Medium"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="160,*" RowDefinitions="Auto,Auto,Auto">
                        <TextBlock Text="Current version:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,0,12,0"/>
                        <TextBlock Grid.Column="1"
                                   Text="{Binding CurrentVersion}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"/>

                        <TextBlock Grid.Row="1"
                                   Text="Status:"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,12,12,0"/>
                        <TextBlock Grid.Row="1" Grid.Column="1"
                                   Text="{Binding UpdateStatus}"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource PrimaryTextBrush}"
                                   Margin="0,12,0,0"/>

                        <StackPanel Grid.Row="2" Grid.ColumnSpan="2"
                                    Orientation="Horizontal"
                                    Spacing="12"
                                    Margin="0,16,0,0">
                            <Button Content="Check for updates"
                                    Command="{Binding CheckForUpdatesCommand}"
                                    IsEnabled="{Binding IsCheckingForUpdates, Converter={StaticResource InvertBoolConverter}}"
                                    Background="Transparent"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    Foreground="{DynamicResource PrimaryTextBrush}"
                                    BorderThickness="1"/>
                            <Button Content="Install &amp; Restart"
                                    Command="{Binding InstallAndRestartCommand}"
                                    IsVisible="{Binding AvailableUpdateVersion, Converter={StaticResource IsNotNullConverter}}"
                                    Background="{DynamicResource AccentBrush}"
                                    Foreground="White"
                                    BorderThickness="0"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Content="Reset"
                        Command="{Binding ResetCommand}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Foreground="{DynamicResource PrimaryTextBrush}"
                        BorderThickness="1"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Background="{DynamicResource AccentBrush}"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
