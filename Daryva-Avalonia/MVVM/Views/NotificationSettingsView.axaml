<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Daryva.MVVM.Converters;assembly=Daryva"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="Daryva.MVVM.Views.NotificationSettingsView"
             x:CompileBindings="False">
    <UserControl.Resources>
        <conv:IntToStringConverter x:Key="IntToStringConverter"/>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="0,0,0,24" Spacing="24">
            <!-- Header -->
            <TextBlock Text="Notification Settings"
                       FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <!-- Reminder Rules -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Padding="20,16">
                <StackPanel Spacing="20">
                    <TextBlock Text="Reminder Rules"
                               FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>

                    <!-- Rent Due Reminder -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Rent Due Reminder"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <CheckBox IsChecked="{Binding RentDueReminderEnabled, Mode=TwoWay}"
                                  Content="Enabled"/>
                        <Grid ColumnDefinitions="240,*" RowDefinitions="Auto" Margin="24,0,0,0">
                            <TextBlock Text="Send X days before due:"
                                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding RentDueReminderDaysBefore, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"
                                     MinWidth="80"
                                     Padding="8,6"/>
                        </Grid>
                    </StackPanel>

                    <!-- Rent Overdue Reminder -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Rent Overdue Reminder"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <CheckBox IsChecked="{Binding RentOverdueReminderEnabled, Mode=TwoWay}"
                                  Content="Enabled"/>
                        <Grid ColumnDefinitions="240,*" RowDefinitions="Auto" Margin="24,0,0,0">
                            <TextBlock Text="Send X days after due:"
                                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding RentOverdueReminderDaysAfter, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"
                                     MinWidth="80"
                                     Padding="8,6"/>
                        </Grid>
                    </StackPanel>

                    <!-- Document Expiry Reminder -->
                    <StackPanel Spacing="8">
                        <TextBlock Text="Document Expiry Reminder"
                                   FontWeight="SemiBold"
                                   FontSize="13"/>
                        <CheckBox IsChecked="{Binding DocumentExpiryReminderEnabled, Mode=TwoWay}"
                                  Content="Enabled"/>
                        <Grid ColumnDefinitions="240,*" RowDefinitions="Auto" Margin="24,0,0,0">
                            <TextBlock Text="Send X days before expiry:"
                                       VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                            <TextBox Grid.Column="1"
                                     Text="{Binding DocumentExpiryReminderDaysBefore, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"
                                     MinWidth="80"
                                     Padding="8,6"/>
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Sending Behavior -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Padding="20,16">
                <StackPanel Spacing="20">
                    <TextBlock Text="Sending Behavior"
                               FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Quiet Hours:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding QuietHoursStart, Mode=TwoWay}"
                                     MinWidth="70"
                                     Padding="8,6"/>
                            <TextBlock Text="to"
                                       VerticalAlignment="Center"
                                       Opacity="0.8"/>
                            <TextBox Text="{Binding QuietHoursEnd, Mode=TwoWay}"
                                     MinWidth="70"
                                     Padding="8,6"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding SendOnWeekends, Mode=TwoWay}"
                                  Content="Send on weekends"/>
                    </StackPanel>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Default Channel:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding NotificationChannelOptions}"
                                  SelectedItem="{Binding DefaultNotificationChannel, Mode=TwoWay}"
                                  MinWidth="160"
                                  PlaceholderText="Select channel"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Content="Reset"
                        Command="{Binding ResetCommand}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
