<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Daryva.MVVM.Converters;assembly=Daryva"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="Daryva.MVVM.Views.EmailSettingsView"
             x:CompileBindings="False">
    <UserControl.Resources>
        <conv:IntToStringConverter x:Key="IntToStringConverter"/>
        <conv:DateTimeToDisplayConverter x:Key="DateTimeToDisplayConverter"/>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="0,0,0,24" Spacing="24">
            <!-- Header -->
            <TextBlock Text="Email / Integrations Settings"
                       FontSize="24" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryTextBrush}"/>

            <!-- SMTP Configuration -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Padding="20,16">
                <StackPanel Spacing="20">
                    <TextBlock Text="SMTP Configuration"
                               FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>
                    <TextBlock Text="Note: SMTP settings are stored in App.config.local for security."
                               FontSize="12"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               TextWrapping="Wrap"
                               Margin="0,0,0,8"/>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="SMTP Server:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SmtpServer, Mode=TwoWay}"
                                 MinWidth="280"
                                 Padding="8,6"/>
                    </Grid>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Port:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SmtpPort, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"
                                 MinWidth="80"
                                 Padding="8,6"/>
                    </Grid>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Username:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding SmtpUsername, Mode=TwoWay}"
                                 MinWidth="280"
                                 Padding="8,6"/>
                    </Grid>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Password:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding SmtpPassword, Mode=TwoWay}"
                                     MinWidth="220"
                                     Padding="8,6"/>
                            <TextBlock Text="(Stored in App.config.local)"
                                       FontSize="12"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="From Address:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding FromAddress, Mode=TwoWay}"
                                 MinWidth="280"
                                 Padding="8,6"/>
                    </Grid>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Test email address:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Vertical" Spacing="2">
                            <TextBox Text="{Binding TestEmailAddress, Mode=TwoWay}"
                                     MinWidth="280"
                                     Padding="8,6"
                                     Watermark="e.g. you@example.com"/>
                            <TextBlock Text="Used by 'Test Email'. Save settings first, then send test to this address."
                                       FontSize="11"
                                       Foreground="{DynamicResource SecondaryTextBrush}"
                                       TextWrapping="Wrap"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding EnableSsl, Mode=TwoWay}"
                                  Content="Enable SSL"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Status -->
            <Border BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="{DynamicResource SecondaryBackgroundBrush}"
                    Padding="20,16">
                <StackPanel Spacing="20">
                    <TextBlock Text="Status"
                               FontSize="13" FontWeight="Medium" Foreground="{DynamicResource SecondaryTextBrush}"
                               Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Status:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding EmailStatus, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 MinWidth="160"
                                 Padding="8,6"/>
                    </Grid>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Last Test:"
                                   VerticalAlignment="Center" Foreground="{DynamicResource PrimaryTextBrush}" Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding LastTestTime, Converter={StaticResource DateTimeToDisplayConverter}, Mode=OneWay}"
                                 IsReadOnly="True"
                                 Background="{DynamicResource ControlBackgroundBrush}"
                                 MinWidth="160"
                                 Padding="8,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Content="Test Email"
                        Command="{Binding TestEmailCommand}"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"
                        ToolTip.Tip="Enable when SMTP and Test email address are set. Save first, then send."/>
                <Button Content="Reset"
                        Command="{Binding ResetCommand}"
                        Background="Transparent"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
