<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:converters="clr-namespace:Daryva.MVVM.Converters"
        x:Class="Daryva.MVVM.Views.RecordPaymentDialog"
        x:CompileBindings="False"
        Title="Record Payment" 
        Height="700" 
        Width="600"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Window.Resources>
        <converters:IsNotNullToVisibilityConverter x:Key="IsNotNullToVisibilityConverter"/>
        <converters:DecimalToStringConverter x:Key="DecimalToStringConverter"/>
        <converters:SubtractOneConverter x:Key="SubtractOneConverter"/>
    </Window.Resources>
    <Window.Styles>
        <!-- ComboBox dropdown: selected/hover item text readable (white on accent in dark theme) -->
        <Style Selector="ComboBox ListBoxItem:selected">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="ComboBox ListBoxItem:selected TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        </Style>
        <!-- Address line (secondary text) in dropdown - unselected use secondary, selected use accent -->
        <Style Selector="ComboBox ListBoxItem TextBlock.AddressLine">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorSecondaryBrush}"/>
        </Style>
        <Style Selector="ComboBox ListBoxItem:selected TextBlock.AddressLine">
            <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
        </Style>
        <!-- When ComboBox is closed, selected item is shown in content area - keep address readable -->
        <Style Selector="ComboBox TextBlock.AddressLine">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="ComboBox ListBoxItem:pointerover">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
        <Style Selector="ComboBox ListBoxItem:pointerover TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
        </Style>
    </Window.Styles>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Record Payment" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">
                <TextBlock Text="Select Tenancy" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <ComboBox ItemsSource="{Binding Tenancies}"
                         SelectedItem="{Binding SelectedTenancy}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <StackPanel>
                                <TextBlock FontWeight="Bold">
                                    <Run Text="{Binding Tenant.FullName}"/>
                                </TextBlock>
                                <TextBlock FontSize="11" Classes="AddressLine">
                                    <Run Text="{Binding House.AddressLine1}"/>
                                    <Run Text=", "/>
                                    <Run Text="{Binding House.City}"/>
                                </TextBlock>
                            </StackPanel>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <Border Background="{DynamicResource CardFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="15" Margin="0,0,0,20" CornerRadius="5" 
                        IsVisible="{Binding SelectedTenancy, Converter={StaticResource IsNotNullToVisibilityConverter}}">
                    <StackPanel>
                        <TextBlock Text="Tenancy Details" FontWeight="Bold" Margin="0,0,0,10"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Grid ColumnDefinitions="140,*" RowDefinitions="*,*,*,*">
                            <TextBlock Grid.Row="0" Grid.Column="0" Text="House:" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Row="0" Grid.Column="1" 
                                       Text="{Binding SelectedTenancyAddress}"/>
                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tenant:" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Row="1" Grid.Column="1" 
                                       Text="{Binding SelectedTenancyTenantName}"/>
                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Monthly Rent:" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Row="2" Grid.Column="1" 
                                       Text="{Binding SelectedTenancyRentAmount, StringFormat='£{0:N2}'}"/>
                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Deposit Required:" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Row="3" Grid.Column="1" 
                                       Text="{Binding SelectedTenancyDepositAmount, StringFormat='£{0:N2}'}"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Payment Details" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="Collected By:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding CollectedBy}"/>
                </Grid>

                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="Payment Date:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding PaymentDate}"/>
                </Grid>

                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="Payment Method:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding PaymentMethodOptions}" SelectedItem="{Binding PaymentMethod}"/>
                </Grid>

                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="Reference:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding Reference}"/>
                </Grid>

                <Grid ColumnDefinitions="140,*">
                    <TextBlock Grid.Column="0" Text="Notes:" VerticalAlignment="Center"
                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    <TextBox Grid.Column="1" Text="{Binding Notes}" 
                             TextWrapping="Wrap" AcceptsReturn="True" MinHeight="60"/>
                </Grid>

                <Separator Margin="0,10,0,15"/>

                <TextBlock Text="Deposit Payment" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="15" Margin="0,0,0,15" CornerRadius="5">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="*,*">
                            <TextBlock Grid.Column="0" Text="Required Deposit:" FontWeight="Bold"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBlock Grid.Column="1" HorizontalAlignment="Right" 
                                       Text="{Binding SelectedTenancyDepositAmount, StringFormat='£{0:N2}'}"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        </Grid>
                        <Grid ColumnDefinitions="140,*">
                            <TextBlock Grid.Column="0" Text="Pay Deposit:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding DepositAmount, Mode=TwoWay, Converter={StaticResource DecimalToStringConverter}}">
                                <ToolTip.Tip>
                                    <TextBlock Text="Enter deposit amount to pay"/>
                                </ToolTip.Tip>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBlock Text="Rent Payment" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"
                           Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                <Border Background="{DynamicResource LayerFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="15" Margin="0,0,0,15" CornerRadius="5">
                    <StackPanel Spacing="10">
                        <Grid ColumnDefinitions="140,*">
                            <TextBlock Grid.Column="0" Text="Period:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="10">
                                <ComboBox Width="120" ItemsSource="{Binding MonthOptions}"
                                          SelectedIndex="{Binding RentMonth, Converter={StaticResource SubtractOneConverter}}"/>
                                <ComboBox Width="100" ItemsSource="{Binding YearOptions}"
                                          SelectedItem="{Binding RentYear}"/>
                            </StackPanel>
                        </Grid>
                        <Grid ColumnDefinitions="140,*">
                            <TextBlock Grid.Column="0" Text="Pay Rent:" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                            <TextBox Grid.Column="1" Text="{Binding RentAmount, Mode=TwoWay, Converter={StaticResource DecimalToStringConverter}}">
                                <ToolTip.Tip>
                                    <TextBlock Text="Enter rent amount to pay for selected period"/>
                                </ToolTip.Tip>
                            </TextBox>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Background="{DynamicResource AccentFillColorDefaultBrush}" 
                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        Padding="15" CornerRadius="5">
                    <Grid ColumnDefinitions="*,*">
                        <TextBlock Grid.Column="0" Text="Total Payment:" FontWeight="Bold" FontSize="16"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                        <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontWeight="Bold" FontSize="18" 
                                   Text="{Binding TotalPayment, StringFormat='£{0:N2}'}"
                                   Foreground="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="10">
            <Button Content="Cancel" Width="100" Height="35" Click="CancelButton_Click"/>
            <Button Content="Save" Width="100" Height="35" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
