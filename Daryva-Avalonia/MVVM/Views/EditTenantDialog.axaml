<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:Daryva.MVVM.Converters"
        x:Class="Daryva.MVVM.Views.EditTenantDialog"
        x:CompileBindings="False"
        Title="Edit Tenant" 
        Height="650" 
        Width="500"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        ShowInTaskbar="False">
    <Window.Resources>
        <conv:DecimalToStringConverter x:Key="DecimalToStringConverter"/>
        <conv:ByteToStringConverter x:Key="ByteToStringConverter"/>
    </Window.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Edit Tenant" FontSize="20" FontWeight="Bold" Margin="0,0,0,20"
                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="15">
                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Full Name:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding FullName}"/>
                </Grid>

                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Email:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding Email}"/>
                </Grid>

                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Phone Number:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding PhoneNumber}"/>
                </Grid>

                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="University:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding UniversityName}"/>
                </Grid>

                <Separator Margin="0,10,0,15"/>

                <TextBlock Text="Assign to House" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Move-in Date:" VerticalAlignment="Center"/>
                    <DatePicker Grid.Column="1" SelectedDate="{Binding MoveInDate}"/>
                </Grid>

                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="House:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" 
                             ItemsSource="{Binding Houses}"
                             SelectedItem="{Binding SelectedHouse}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock>
                                    <Run Text="{Binding AddressLine1}"/>
                                    <Run Text=", "/>
                                    <Run Text="{Binding City}"/>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>

                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Rent starts from:" VerticalAlignment="Center"/>
                    <ComboBox Grid.Column="1" ItemsSource="{Binding RentStartOptions}" SelectedItem="{Binding RentStartOption}"/>
                </Grid>

                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Monthly Rent:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding RentAmountMonthly, Mode=TwoWay, Converter={StaticResource DecimalToStringConverter}}"/>
                </Grid>

                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Deposit:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding DepositAmount, Mode=TwoWay, Converter={StaticResource DecimalToStringConverter}}"/>
                </Grid>

                <Grid ColumnDefinitions="120,*">
                    <TextBlock Grid.Column="0" Text="Payment Due Day:" VerticalAlignment="Center"/>
                    <TextBox Grid.Column="1" Text="{Binding PaymentDueDay, Mode=TwoWay, Converter={StaticResource ByteToStringConverter}}">
                        <ToolTip.Tip>
                            <TextBlock Text="Day of month (1-28) when rent is due"/>
                        </ToolTip.Tip>
                    </TextBox>
                </Grid>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="10">
            <Button Content="Cancel" Width="100" Height="35" Click="CancelButton_Click"/>
            <Button Content="Save" Width="100" Height="35" Command="{Binding SaveCommand}"/>
        </StackPanel>
    </Grid>
</Window>
