---
interface Props {
  code: string;
  title: string;
}
const { code, title } = Astro.props;
---

<div class="entry">
  <span class="code mono">{code}</span>
  <div class="body">
    <h3>{title}</h3>
    <p><slot /></p>
  </div>
</div>

<style>
  .entry {
    display: grid;
    grid-template-columns: 64px 1fr;
    gap: 20px;
    padding: 26px 0;
    border-bottom: 1px solid var(--rule);
  }

  .entry:last-child {
    border-bottom: none;
  }

  .code {
    font-size: 12.5px;
    color: var(--accent-bright);
    padding-top: 4px;
  }

  h3 {
    font-size: 19px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  p {
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.65;
  }

  @media (max-width: 560px) {
    .entry {
      grid-template-columns: 1fr;
      gap: 8px;
    }
  }
</style>
