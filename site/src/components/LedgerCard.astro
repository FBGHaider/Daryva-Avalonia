---
const rows = [
  { tenant: 'J. Whitfield', house: '14 Elm Court', due: '850.00', paid: '850.00', status: 'Paid' },
  { tenant: 'A. Osei', house: '6 Birch Row', due: '725.00', paid: '725.00', status: 'Paid' },
  { tenant: 'R. Ahmad', house: '2 Maple Court', due: '600.00', paid: '600.00', status: 'From deposit' },
];
---

<div class="ledger">
  <div class="ledger-head">
    <span class="mono label">Rent ledger — August</span>
    <span class="mono total">£2,175.00</span>
  </div>

  <div class="ledger-table" role="table" aria-label="Sample rent ledger">
    <div class="row row-head" role="row">
      <span role="columnheader">Tenant</span>
      <span role="columnheader">Property</span>
      <span role="columnheader" class="num">Due</span>
      <span role="columnheader" class="num">Paid</span>
      <span role="columnheader">Status</span>
    </div>
    {rows.map((r) => (
      <div class="row" role="row">
        <span role="cell">{r.tenant}</span>
        <span role="cell" class="dim">{r.house}</span>
        <span role="cell" class="num mono">£{r.due}</span>
        <span role="cell" class="num mono">£{r.paid}</span>
        <span role="cell">
          <span class={`pill ${r.status === 'Paid' ? 'pill-paid' : 'pill-deposit'}`}>{r.status}</span>
        </span>
      </div>
    ))}
  </div>

  <p class="footnote">
    <strong>2 Maple Court</strong> paid rent from their deposit this month — Daryva drew it down
    correctly, so only <span class="mono">£460.00</span> of the original <span class="mono">£600.00</span> deposit
    still shows as refundable. Nothing gets double-counted at move-out.
  </p>
</div>

<style>
  .ledger {
    background: var(--paper);
    color: var(--on-paper);
    border-radius: 4px;
    padding: 26px 28px 24px;
    box-shadow: 0 40px 80px -30px rgba(0, 0, 0, 0.55), 0 2px 0 rgba(255, 255, 255, 0.4) inset;
    transform: rotate(-0.6deg);
  }

  .ledger-head {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding-bottom: 16px;
    border-bottom: 1px solid var(--paper-rule);
    margin-bottom: 4px;
  }

  .label {
    font-size: 11.5px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--on-paper-muted);
  }

  .total {
    font-size: 15px;
    font-weight: 600;
  }

  .ledger-table {
    display: flex;
    flex-direction: column;
  }

  .row {
    display: grid;
    grid-template-columns: 1.3fr 1.4fr 0.85fr 0.85fr 1fr;
    gap: 10px;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--paper-rule);
    font-size: 13.5px;
  }

  .row:last-of-type {
    border-bottom: none;
  }

  .row-head {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.07em;
    text-transform: uppercase;
    color: var(--on-paper-muted);
    padding-top: 2px;
    padding-bottom: 10px;
  }

  .dim {
    color: var(--on-paper-muted);
  }

  .num {
    text-align: right;
  }

  .pill {
    display: inline-block;
    font-size: 11px;
    font-family: var(--font-mono);
    padding: 3px 8px;
    border-radius: 20px;
    letter-spacing: 0.01em;
  }

  .pill-paid {
    background: rgba(28, 42, 36, 0.08);
    color: var(--on-paper-muted);
  }

  .pill-deposit {
    background: rgba(198, 154, 82, 0.16);
    color: #8a6421;
  }

  .footnote {
    margin-top: 18px;
    padding-top: 16px;
    border-top: 1px dashed var(--paper-rule);
    font-size: 12.5px;
    line-height: 1.6;
    color: var(--on-paper-muted);
    max-width: none;
  }

  .footnote strong {
    color: var(--on-paper);
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 1fr 1fr;
      grid-template-areas:
        'tenant status'
        'house house'
        'due paid';
      row-gap: 6px;
    }
    .row-head {
      display: none;
    }
    .num {
      text-align: left;
    }
  }
</style>
