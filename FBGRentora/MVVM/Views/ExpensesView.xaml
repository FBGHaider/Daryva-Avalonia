<UserControl x:Class="FBGRentora.MVVM.Views.ExpensesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FBGRentora.MVVM.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Loaded="ExpensesView_Loaded">
    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:BoolToCheckConverter x:Key="BoolToCheckConverter"/>
        <converters:TabToIndexConverter x:Key="TabToIndexConverter"/>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Expenses" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Filter Bar -->
        <Border Grid.Row="1" Background="{DynamicResource CardFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,15" CornerRadius="8">
            <WrapPanel Orientation="Horizontal">
                <!-- Date Range Filter -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <TextBlock Text="Date Range:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox SelectedValue="{Binding DateRangeFilter}" 
                             SelectedValuePath="Content"
                             Width="150" Padding="5">
                        <ComboBox.Items>
                            <ComboBoxItem Content="This Month"/>
                            <ComboBoxItem Content="Last 3 Months"/>
                            <ComboBoxItem Content="This Year"/>
                            <ComboBoxItem Content="All"/>
                        </ComboBox.Items>
                    </ComboBox>
                </StackPanel>

                <!-- House Filter -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <TextBlock Text="House:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox ItemsSource="{Binding Houses}"
                             SelectedValue="{Binding SelectedHouseId}"
                             SelectedValuePath="HouseId"
                             DisplayMemberPath="AddressLine1"
                             Width="200" Padding="5"/>
                </StackPanel>

                <!-- Category Filter -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <TextBlock Text="Category:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <ComboBox SelectedValue="{Binding CategoryFilter}" 
                             SelectedValuePath="Content"
                             Width="150" Padding="5">
                        <ComboBox.Items>
                            <ComboBoxItem Content="All"/>
                            <ComboBoxItem Content="Repairs"/>
                            <ComboBoxItem Content="Bills"/>
                            <ComboBoxItem Content="CouncilTax"/>
                            <ComboBoxItem Content="Internet"/>
                            <ComboBoxItem Content="Furniture"/>
                            <ComboBoxItem Content="Cleaning"/>
                            <ComboBoxItem Content="Maintenance"/>
                            <ComboBoxItem Content="Other"/>
                        </ComboBox.Items>
                    </ComboBox>
                </StackPanel>

                <!-- Search -->
                <StackPanel Orientation="Horizontal" Margin="0,0,20,10">
                    <TextBlock Text="Search:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                    <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}" 
                            Width="200" Padding="5"/>
                </StackPanel>

                <!-- Action Buttons -->
                <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                    <Button Content="+ Add Expense" 
                           Command="{Binding AddExpenseCommand}" 
                           Style="{StaticResource PrimaryButtonStyle}"
                           Padding="12,8"
                           MinWidth="120"
                           MinHeight="32"
                           Margin="0,0,10,0"/>
                    <Button Content="Export CSV" 
                           Command="{Binding ExportCsvCommand}" 
                           Padding="12,8"
                           MinWidth="100"
                           MinHeight="32"/>
                </StackPanel>
            </WrapPanel>
        </Border>

        <!-- Tab Control for List and Summary -->
        <TabControl Grid.Row="2" SelectionChanged="TabControl_SelectionChanged">
            <TabItem Header="Expenses List">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <!-- Expenses Table -->
                    <DataGrid Grid.Row="0" 
                             ItemsSource="{Binding Expenses}"
                             SelectedItem="{Binding SelectedExpense}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             IsReadOnly="True"
                             GridLinesVisibility="All"
                             HeadersVisibility="Column"
                             MinHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Date" Binding="{Binding DateIncurred, StringFormat='{}{0:yyyy-MM-dd}'}" Width="100"/>
                            <DataGridTextColumn Header="House" Binding="{Binding HouseAddress}" Width="*"/>
                            <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="120"/>
                            <DataGridTextColumn Header="Vendor" Binding="{Binding Vendor}" Width="150"/>
                            <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*"/>
                            <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='{}{0:C}'}" Width="100"/>
                            <DataGridTemplateColumn Header="Receipt" Width="80">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding HasReceipt, Converter={StaticResource BoolToCheckConverter}}" 
                                                  HorizontalAlignment="Center" FontSize="16"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Edit" 
                                                   Command="{Binding DataContext.EditExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Width="60" Height="25" Margin="2"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   FontSize="11"/>
                                            <Button Content="Receipt" 
                                                   Command="{Binding DataContext.ViewReceiptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Width="70" Height="25" Margin="2"
                                                   IsEnabled="{Binding HasReceipt}"
                                                   Background="#FF9800" Foreground="White" BorderBrush="#FF9800" FontSize="11"/>
                                            <Button Content="Delete" 
                                                   Command="{Binding DataContext.DeleteExpenseCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Width="60" Height="25" Margin="2"
                                                   Background="#D13438" Foreground="White" BorderBrush="#D13438" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Action Buttons Row -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,10,0,0">
                        <Button Content="Attach Receipt" 
                               Command="{Binding AttachReceiptCommand}" 
                               Style="{StaticResource PrimaryButtonStyle}"
                               Padding="12,8"
                               MinWidth="120"
                               MinHeight="32"
                               Margin="0,0,10,0"
                               IsEnabled="{Binding SelectedExpense, Converter={StaticResource IsNotNullConverter}}"/>
                    </StackPanel>
                </Grid>
            </TabItem>

            <TabItem Header="Summary &amp; Reports">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="0,10,0,0">
                        <!-- Summary Cards -->
                        <Grid Margin="0,0,0,20">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Background="#1E3A5F" Padding="15" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Total Expenses" FontSize="12" Foreground="#B3D9FF"/>
                                    <TextBlock Text="{Binding Summary.TotalAmount, StringFormat='{}{0:C}'}" 
                                              FontSize="24" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="1" Background="#3A1E4A" Padding="15" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Average Monthly" FontSize="12" Foreground="#E6B3FF"/>
                                    <TextBlock Text="{Binding Summary.AverageMonthlyAmount, StringFormat='{}{0:C}'}" 
                                              FontSize="24" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#1E4A2E" Padding="15" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Biggest Category" FontSize="12" Foreground="#B3FFB3"/>
                                    <TextBlock Text="{Binding Summary.BiggestCategory}" 
                                              FontSize="18" FontWeight="Bold" Foreground="White"/>
                                    <TextBlock Text="{Binding Summary.BiggestCategoryAmount, StringFormat='{}{0:C}'}" 
                                              FontSize="14" Foreground="#B3FFB3"/>
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="3" Background="#4A3A1E" Padding="15" Margin="5" CornerRadius="8" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1">
                                <StackPanel>
                                    <TextBlock Text="Highest Single" FontSize="12" Foreground="#FFE6B3"/>
                                    <TextBlock Text="{Binding Summary.HighestSingleExpense, StringFormat='{}{0:C}'}" 
                                              FontSize="24" FontWeight="Bold" Foreground="White"/>
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Breakdown Tables -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- By House -->
                            <GroupBox Grid.Column="0" Header="By House" Margin="5" Padding="10">
                                <DataGrid ItemsSource="{Binding Summary.ByHouse}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         IsReadOnly="True"
                                         HeadersVisibility="Column"
                                         MinHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="House" Binding="{Binding HouseAddress}" Width="*"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:C}'}" Width="100"/>
                                        <DataGridTextColumn Header="%" Binding="{Binding PercentageOfTotal, StringFormat='{}{0:F1}%'}" Width="80"/>
                                        <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>

                            <!-- By Category -->
                            <GroupBox Grid.Column="1" Header="By Category" Margin="5" Padding="10" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <DataGrid ItemsSource="{Binding Summary.ByCategory}"
                                         AutoGenerateColumns="False"
                                         CanUserAddRows="False"
                                         IsReadOnly="True"
                                         HeadersVisibility="Column"
                                         MinHeight="200">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Category" Binding="{Binding Category}" Width="*"/>
                                        <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:C}'}" Width="100"/>
                                        <DataGridTextColumn Header="Count" Binding="{Binding Count}" Width="80"/>
                                        <DataGridTextColumn Header="Average" Binding="{Binding Average, StringFormat='{}{0:C}'}" Width="100"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </GroupBox>
                        </Grid>

                        <!-- Monthly Trend -->
                        <GroupBox Header="Monthly Trend" Margin="5,20,5,5" Padding="10" Background="{DynamicResource CardFillColorDefaultBrush}">
                            <DataGrid ItemsSource="{Binding Summary.ByMonth}"
                                     AutoGenerateColumns="False"
                                     CanUserAddRows="False"
                                     IsReadOnly="True"
                                     HeadersVisibility="Column"
                                     MinHeight="200">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Month" Binding="{Binding MonthName}" Width="150"/>
                                    <DataGridTextColumn Header="Total" Binding="{Binding Total, StringFormat='{}{0:C}'}" Width="100"/>
                                    <DataGridTextColumn Header="Repairs" Binding="{Binding Repairs, StringFormat='{}{0:C}'}" Width="100"/>
                                    <DataGridTextColumn Header="Bills" Binding="{Binding Bills, StringFormat='{}{0:C}'}" Width="100"/>
                                    <DataGridTextColumn Header="Other" Binding="{Binding Other, StringFormat='{}{0:C}'}" Width="100"/>
                                </DataGrid.Columns>
                            </DataGrid>
                        </GroupBox>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
