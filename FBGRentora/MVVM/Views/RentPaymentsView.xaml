<UserControl x:Class="FBGRentora.MVVM.Views.RentPaymentsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:FBGRentora.MVVM.Converters"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <UserControl.Resources>
        <converters:TabNameToIndexConverter x:Key="TabNameToIndexConverter"/>
    </UserControl.Resources>
    <Grid Margin="0">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header with buttons -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Rent &amp; Payments" Style="{StaticResource Heading1}" VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Content="Record Payment" Command="{Binding RecordPaymentCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="5,0"/>
                <Button Content="Export" Command="{Binding ExportLedgerCommand}" Margin="5,0"/>
            </StackPanel>
        </Grid>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" SelectedIndex="{Binding SelectedTab, Converter={StaticResource TabNameToIndexConverter}, Mode=TwoWay}">
            <!-- Rent Ledger Tab -->
            <TabItem Header="Rent Ledger">
                <ContentControl Content="{Binding LedgerViewModel}"/>
            </TabItem>
            
            <!-- Transactions Tab -->
            <TabItem Header="Transactions">
                <ContentControl Content="{Binding TransactionsViewModel}"/>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
