<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <connectionStrings>
    <!-- SQL Server running in Docker container -->
    <!-- Default Docker SQL Server credentials: sa / YourStrong@Password123 -->
    <add name="DefaultConnection" 
         connectionString="Server=localhost,1433;Database=FBGRentoraDB;User Id=sa;Password=YourStrong@Password123;TrustServerCertificate=True;Encrypt=True;MultipleActiveResultSets=True;" 
         providerName="Microsoft.Data.SqlClient" />
  </connectionStrings>
  <appSettings>
    <!-- SMTP Email Configuration -->
    <!-- 
    For Gmail:
    - SmtpServer: smtp.gmail.com
    - SmtpPort: 587
    - SmtpUsername: your-email@gmail.com
    - SmtpPassword: your-app-password (generate from Google Account settings)
    - SmtpEnableSsl: true
    - SmtpFromAddress: your-email@gmail.com
    
    For Outlook/Hotmail:
    - SmtpServer: smtp-mail.outlook.com
    - SmtpPort: 587
    - SmtpUsername: your-email@outlook.com
    - SmtpPassword: your-password
    - SmtpEnableSsl: true
    - SmtpFromAddress: your-email@outlook.com
    -->
    <!-- SMTP settings are loaded from App.config.local (gitignored) -->
    <!-- Copy App.config.local.example to App.config.local and configure your settings -->
    <!-- These are placeholders - actual values should be in App.config.local -->
    <!--
    <add key="SmtpServer" value="smtp.gmail.com" />
    <add key="SmtpPort" value="587" />
    <add key="SmtpUsername" value="your-email@gmail.com" />
    <add key="SmtpPassword" value="your-app-password" />
    <add key="SmtpEnableSsl" value="true" />
    <add key="SmtpFromAddress" value="your-email@gmail.com" />
    -->
  </appSettings>
</configuration>
