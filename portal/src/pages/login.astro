---
import BaseLayout from '../layouts/BaseLayout.astro';
import { setAuthCookies } from '../lib/api';

const API_BASE_URL = import.meta.env.API_BASE_URL || 'http://localhost:5000';

let error: string | null = null;

if (Astro.request.method === 'POST') {
  const formData = await Astro.request.formData();
  const email = formData.get('email')?.toString() ?? '';
  const password = formData.get('password')?.toString() ?? '';

  if (!email || !password) {
    error = 'Email and password are required.';
  } else {
    try {
      const response = await fetch(`${API_BASE_URL}/api/auth/login`, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({ email, password }),
      });

      if (response.status === 401) {
        error = 'Incorrect email or password.';
      } else if (!response.ok) {
        error = 'Something went wrong. Please try again.';
      } else {
        const result = await response.json();
        if (result.requiresTwoFactor) {
          error = 'Two-factor accounts are not yet supported in the tenant portal. Contact your landlord for help.';
        } else if (result.accessToken) {
          setAuthCookies(Astro.cookies, {
            accessToken: result.accessToken,
            refreshToken: result.refreshToken,
            accessTokenExpiresAt: result.accessTokenExpiresAt,
          });
          return Astro.redirect('/');
        } else {
          error = 'Something went wrong. Please try again.';
        }
      }
    } catch {
      error = 'Could not reach the server. Please try again.';
    }
  }
}
---

<BaseLayout title="Log in">
  <div class="card form-card">
    <h1 class="page-title">Log in</h1>
    <p class="page-lede">Access your tenancy documents.</p>
    {error && <p class="form-error">{error}</p>}
    <form method="POST">
      <div class="field">
        <label for="email">Email</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>
      <div class="field">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" required autocomplete="current-password" />
      </div>
      <button type="submit" class="btn btn-primary">Log in</button>
    </form>
  </div>
</BaseLayout>
