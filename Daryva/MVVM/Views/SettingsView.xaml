<UserControl x:Class="Daryva.MVVM.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:viewmodels="clr-namespace:Daryva.MVVM.ViewModels"
             xmlns:converters="clr-namespace:Daryva.MVVM.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200">
    <UserControl.Resources>
        <converters:IsNotNullConverter x:Key="IsNotNullConverter"/>
        <converters:BoolToCheckConverter x:Key="BoolToCheckConverter"/>
    </UserControl.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation -->
        <Border Grid.Column="0" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="0,0,1,0" Background="{DynamicResource NavigationViewBackgroundBrush}">
            <ListBox ItemsSource="{Binding Sections}"
                     SelectedItem="{Binding SelectedSection}"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="0">
                <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="15,12"/>
                        <Setter Property="Margin" Value="0,2"/>
                        <Setter Property="Background" Value="Transparent"/>
                        <Setter Property="Foreground" Value="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <Setter Property="BorderThickness" Value="0"/>
                        <Style.Triggers>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="{DynamicResource AccentFillColorDefaultBrush}"/>
                                <Setter Property="Foreground" Value="{DynamicResource TextOnAccentFillColorPrimaryBrush}"/>
                                <Setter Property="FontWeight" Value="SemiBold"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource ControlFillColorSecondaryBrush}"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
        </Border>

        <!-- Content Area -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto">
            <ContentControl Content="{Binding CurrentSectionViewModel}" Margin="20">
                <ContentControl.Resources>
                    <!-- General Settings Template -->
                    <DataTemplate DataType="{x:Type viewmodels:GeneralSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Text="General Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                            
                            <GroupBox Header="Appearance &amp; Behavior" Margin="0,0,0,20" Padding="15">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Currency:" Width="200" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Currency}" VerticalAlignment="Center" FontWeight="Bold" Foreground="Gray"/>
                                        <TextBlock Text="(Read-only)" Margin="10,0,0,0" VerticalAlignment="Center" FontStyle="Italic" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Date Format:" Width="200" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding DateFormatOptions}"
                                                 SelectedItem="{Binding DateFormat}"
                                                 Width="200"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Time Zone:" Width="200" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding TimeZone}" Width="200"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="App Start Page:" Width="200" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding AppStartPageOptions}"
                                                 SelectedItem="{Binding AppStartPage}"
                                                 Width="200"/>
                                    </StackPanel>
                                    
                                    <CheckBox Content="Confirm destructive actions (Delete, End tenancy)"
                                             IsChecked="{Binding ConfirmDestructiveActions}"
                                             Margin="0,10,0,0"/>
                                    
                                    <CheckBox Content="Auto-refresh dashboard"
                                             IsChecked="{Binding AutoRefreshDashboard}"
                                             Margin="0,10,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Reset" Command="{Binding ResetCommand}" Padding="15,8" Margin="0,0,10,0"/>
                                <Button Content="Save" Command="{Binding SaveCommand}" Padding="15,8" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Theme Settings Template -->
                    <DataTemplate DataType="{x:Type viewmodels:ThemeSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Text="Theme Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                            
                            <GroupBox Header="Appearance" Margin="0,0,0,20" Padding="15" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Theme:" Width="200" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding ThemeOptions}"
                                                 SelectedItem="{Binding SelectedTheme, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                 Width="200"/>
                                        <TextBlock Text="(Select Dark or Light theme)" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    
                                    <TextBlock Text="Changing the theme will immediately update the application appearance. Click 'Save' to persist your preference." 
                                              Foreground="Gray" FontStyle="Italic" TextWrapping="Wrap" Margin="0,10,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Reset" Command="{Binding ResetCommand}" Padding="15,8" Margin="0,0,10,0"/>
                                <Button Content="Save" Command="{Binding SaveCommand}" Padding="15,8" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Rent Settings Template -->
                    <DataTemplate DataType="{x:Type viewmodels:RentSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Text="Rent &amp; Finance Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                            
                            <GroupBox Header="Rent Defaults" Margin="0,0,0,20" Padding="15" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Default Rent Due Day:" Width="250" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding DefaultRentDueDay}" Width="100"/>
                                        <TextBlock Text="(1-28)" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Grace Period (days):" Width="250" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding RentGracePeriodDays}" Width="100"/>
                                        <TextBlock Text="Overdue starts after: Due date + grace period" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    
                                    <CheckBox Content="Allow partial payments"
                                             IsChecked="{Binding AllowPartialPayments}"
                                             Margin="0,10,0,0"/>
                                    
                                    <CheckBox Content="Allow overpayment → credit balance"
                                             IsChecked="{Binding AllowOverpayment}"
                                             Margin="0,10,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Reset" Command="{Binding ResetCommand}" Padding="15,8" Margin="0,0,10,0"/>
                                <Button Content="Save" Command="{Binding SaveCommand}" Padding="15,8" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Document Settings Template -->
                    <DataTemplate DataType="{x:Type viewmodels:DocumentSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Text="Document Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                            
                            <GroupBox Header="Upload Rules" Margin="0,0,0,20" Padding="15" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Max File Size (MB):" Width="250" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding MaxFileSizeMB}" Width="100"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Allowed Formats:" Width="250" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding AllowedFormats}" Width="300"/>
                                        <TextBlock Text="(PDF, JPG, PNG, DOCX)" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    
                                    <CheckBox Content="Auto-version documents"
                                             IsChecked="{Binding AutoVersionDocuments}"
                                             Margin="0,10,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <GroupBox Header="Expiry Rules" Margin="0,0,0,20" Padding="15" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Student Letter Validity (months):" Width="250" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding StudentLetterValidityMonths}" Width="100"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Notify Before Expiry (days):" Width="250" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding NotifyBeforeExpiryDays}" Width="100"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            
                            <GroupBox Header="Storage" Margin="0,0,0,20" Padding="15" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Document Storage Path:" Width="250" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding DocumentStoragePath}" Width="400" IsReadOnly="True"/>
                                        <Button Content="Browse..." Command="{Binding BrowseStoragePathCommand}" Padding="10,5" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    
                                    <CheckBox Content="Open documents in app viewer"
                                             IsChecked="{Binding OpenDocumentsInApp}"
                                             Margin="0,10,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Reset" Command="{Binding ResetCommand}" Padding="15,8" Margin="0,0,10,0"/>
                                <Button Content="Save" Command="{Binding SaveCommand}" Padding="15,8" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Notification Settings Template -->
                    <DataTemplate DataType="{x:Type viewmodels:NotificationSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Text="Notification Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                            
                            <GroupBox Header="Reminder Rules" Margin="0,0,0,20" Padding="15" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <StackPanel>
                                    <GroupBox Header="Rent Due Reminder" Margin="0,0,0,15" Padding="10" Background="{DynamicResource LayerFillColorDefaultBrush}">
                                        <StackPanel>
                                            <CheckBox Content="Enabled" IsChecked="{Binding RentDueReminderEnabled}" Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding RentDueReminderEnabled}">
                                                <TextBlock Text="Send X days before due:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox Text="{Binding RentDueReminderDaysBefore}" Width="100"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    
                                    <GroupBox Header="Rent Overdue Reminder" Margin="0,0,0,15" Padding="10" Background="{DynamicResource LayerFillColorDefaultBrush}">
                                        <StackPanel>
                                            <CheckBox Content="Enabled" IsChecked="{Binding RentOverdueReminderEnabled}" Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding RentOverdueReminderEnabled}">
                                                <TextBlock Text="Send X days after due:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox Text="{Binding RentOverdueReminderDaysAfter}" Width="100"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                    
                                    <GroupBox Header="Document Expiry Reminder" Margin="0,0,0,15" Padding="10" Background="{DynamicResource LayerFillColorDefaultBrush}">
                                        <StackPanel>
                                            <CheckBox Content="Enabled" IsChecked="{Binding DocumentExpiryReminderEnabled}" Margin="0,0,0,10"/>
                                            <StackPanel Orientation="Horizontal" IsEnabled="{Binding DocumentExpiryReminderEnabled}">
                                                <TextBlock Text="Send X days before expiry:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                                <TextBox Text="{Binding DocumentExpiryReminderDaysBefore}" Width="100"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </GroupBox>
                                </StackPanel>
                            </GroupBox>
                            
                            <GroupBox Header="Sending Behavior" Margin="0,0,0,20" Padding="15" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Quiet Hours:" Width="200" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding QuietHoursStart}" Width="80"/>
                                        <TextBlock Text=" to " VerticalAlignment="Center" Margin="5,0"/>
                                        <TextBox Text="{Binding QuietHoursEnd}" Width="80"/>
                                    </StackPanel>
                                    
                                    <CheckBox Content="Send on weekends"
                                             IsChecked="{Binding SendOnWeekends}"
                                             Margin="0,10,0,0"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0">
                                        <TextBlock Text="Default Channel:" Width="200" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding NotificationChannelOptions}"
                                                 SelectedItem="{Binding DefaultNotificationChannel}"
                                                 Width="200"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Reset" Command="{Binding ResetCommand}" Padding="15,8" Margin="0,0,10,0"/>
                                <Button Content="Save" Command="{Binding SaveCommand}" Padding="15,8" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Email Settings Template -->
                    <DataTemplate DataType="{x:Type viewmodels:EmailSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Text="Email / Integrations Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                            
                            <GroupBox Header="SMTP Configuration" Margin="0,0,0,20" Padding="15" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <StackPanel>
                                    <TextBlock Text="Note: SMTP settings are stored in App.config.local for security." 
                                              Foreground="Gray" FontStyle="Italic" Margin="0,0,0,15"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="SMTP Server:" Width="200" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SmtpServer}" Width="300"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Port:" Width="200" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SmtpPort}" Width="100"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Username:" Width="200" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SmtpUsername}" Width="300"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Password:" Width="200" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding SmtpPassword}" Width="300"/>
                                        <TextBlock Text="(Stored in App.config.local)" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="Gray" FontSize="11"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="From Address:" Width="200" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding FromAddress}" Width="300"/>
                                    </StackPanel>
                                    
                                    <CheckBox Content="Enable SSL"
                                             IsChecked="{Binding EnableSsl}"
                                             Margin="0,10,0,0"/>
                                </StackPanel>
                            </GroupBox>
                            
                            <GroupBox Header="Status" Margin="0,0,0,20" Padding="15" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Status:" Width="200" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding EmailStatus}" FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="Gray"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding EmailStatus}" Value="Connected">
                                                            <Setter Property="Foreground" Value="Green"/>
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding EmailStatus}" Value="Failed">
                                                            <Setter Property="Foreground" Value="Red"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Visibility="{Binding LastTestTime, Converter={StaticResource IsNotNullConverter}}">
                                        <TextBlock Text="Last Test:" Width="200" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding LastTestTime, StringFormat='{}{0:yyyy-MM-dd HH:mm}'}" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Test Email" Command="{Binding TestEmailCommand}" Padding="15,8" Margin="0,0,10,0" Style="{StaticResource PrimaryButtonStyle}"/>
                                <Button Content="Reset" Command="{Binding ResetCommand}" Padding="15,8" Margin="0,0,10,0"/>
                                <Button Content="Save" Command="{Binding SaveCommand}" Padding="15,8" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>

                    <!-- Backup Settings Template -->
                    <DataTemplate DataType="{x:Type viewmodels:BackupSettingsViewModel}">
                        <StackPanel>
                            <TextBlock Text="Data &amp; Backup Settings" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                            
                            <GroupBox Header="Database Information" Margin="0,0,0,20" Padding="15" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Database Type:" Width="200" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DatabaseType}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                                        <TextBlock Text="Connection Status:" Width="200" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding IsDatabaseConnected, Converter={StaticResource BoolToCheckConverter}}" 
                                                  FontWeight="Bold" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Foreground" Value="Red"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsDatabaseConnected}" Value="True">
                                                            <Setter Property="Foreground" Value="Green"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Database Size:" Width="200" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding DatabaseSizeMB, StringFormat='{}{0:F2} MB'}" VerticalAlignment="Center" FontWeight="Bold"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            
                            <GroupBox Header="Backup Settings" Margin="0,0,0,20" Padding="15" Background="{DynamicResource CardFillColorDefaultBrush}">
                                <StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,0,15">
                                        <TextBlock Text="Backup Location:" Width="200" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding BackupLocation}" Width="400" IsReadOnly="True"/>
                                        <Button Content="Browse..." Command="{Binding BrowseBackupLocationCommand}" Padding="10,5" Margin="10,0,0,0"/>
                                    </StackPanel>
                                    
                                    <Button Content="Backup Now" Command="{Binding BackupNowCommand}" 
                                           Padding="15,8" HorizontalAlignment="Left" 
                                           Background="#FF9800" Foreground="White" BorderBrush="#FF9800" BorderThickness="1"
                                           Margin="0,0,0,20"/>
                                    
                                    <CheckBox Content="Enable automatic backups"
                                             IsChecked="{Binding AutoBackupEnabled}"
                                             Margin="0,10,0,0"/>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0" IsEnabled="{Binding AutoBackupEnabled}">
                                        <TextBlock Text="Frequency:" Width="200" VerticalAlignment="Center"/>
                                        <ComboBox ItemsSource="{Binding BackupFrequencyOptions}"
                                                 SelectedItem="{Binding AutoBackupFrequency}"
                                                 Width="200"/>
                                    </StackPanel>
                                    
                                    <StackPanel Orientation="Horizontal" Margin="0,15,0,0" IsEnabled="{Binding AutoBackupEnabled}">
                                        <TextBlock Text="Retention Policy:" Width="200" VerticalAlignment="Center"/>
                                        <TextBox Text="{Binding BackupRetentionCount}" Width="100"/>
                                        <TextBlock Text="backups" Margin="10,0,0,0" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </StackPanel>
                            </GroupBox>
                            
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button Content="Reset" Command="{Binding ResetCommand}" Padding="15,8" Margin="0,0,10,0"/>
                                <Button Content="Save" Command="{Binding SaveCommand}" Padding="15,8" Style="{StaticResource PrimaryButtonStyle}"/>
                            </StackPanel>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.Resources>
            </ContentControl>
        </ScrollViewer>
    </Grid>
</UserControl>
