<UserControl x:Class="Daryva.MVVM.Views.NotificationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:converters="clr-namespace:Daryva.MVVM.Converters"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="700" d:DesignWidth="1200"
             Loaded="NotificationsView_Loaded">
    <UserControl.Resources>
        <converters:StatusToColorConverter x:Key="StatusToColorConverter"/>
        <converters:StringEqualsConverter x:Key="StringEqualsConverter"/>
        <converters:SubtractOneConverter x:Key="SubtractOneConverter"/>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <TextBlock Grid.Row="0" Text="Notifications" FontSize="28" FontWeight="Bold" Margin="0,0,0,20"/>

        <!-- Tab Control -->
        <TabControl Grid.Row="1" SelectionChanged="TabControl_SelectionChanged">
            <!-- Compose Tab -->
            <TabItem Header="Compose">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="300"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>

                    <!-- Left Panel: Recipients -->
                    <Border Grid.Column="0" Background="{DynamicResource CardFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="15" Margin="0,0,15,0" CornerRadius="8">
                        <StackPanel>
                            <TextBlock Text="Recipients" FontSize="16" FontWeight="Bold" Margin="0,0,0,15"/>

                            <!-- Target Type -->
                            <TextBlock Text="Target Type:" Margin="0,0,0,5"/>
                            <ComboBox SelectedValue="{Binding TargetType}" SelectedValuePath="Content" Margin="0,0,0,15">
                                <ComboBoxItem Content="Single"/>
                                <ComboBoxItem Content="House"/>
                                <ComboBoxItem Content="AllWithStatus"/>
                            </ComboBox>

                            <!-- Single Tenant -->
                            <StackPanel Visibility="{Binding TargetType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=Single}">
                                <TextBlock Text="Tenant:" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Tenants}"
                                         SelectedValue="{Binding SelectedTenantId}"
                                         SelectedValuePath="TenantId"
                                         DisplayMemberPath="FullName"
                                         Margin="0,0,0,15"/>
                            </StackPanel>

                            <!-- House -->
                            <StackPanel Visibility="{Binding TargetType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=House}">
                                <TextBlock Text="House:" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Houses}"
                                         SelectedValue="{Binding SelectedHouseId}"
                                         SelectedValuePath="HouseId"
                                         DisplayMemberPath="AddressLine1"
                                         Margin="0,0,0,15"/>
                            </StackPanel>

                            <!-- All With Status -->
                            <StackPanel Visibility="{Binding TargetType, Converter={StaticResource StringEqualsConverter}, ConverterParameter=AllWithStatus}">
                                <TextBlock Text="Status:" Margin="0,0,0,5"/>
                                <ComboBox SelectedValue="{Binding StatusFilter}" SelectedValuePath="Content" Margin="0,0,0,10">
                                    <ComboBoxItem Content="Due"/>
                                    <ComboBoxItem Content="Overdue"/>
                                    <ComboBoxItem Content="MissingDocs"/>
                                </ComboBox>
                                <TextBlock Text="Month:" Margin="0,0,0,5"/>
                                <ComboBox SelectedIndex="{Binding SelectedMonth, Converter={StaticResource SubtractOneConverter}}" Margin="0,0,0,10">
                                    <ComboBoxItem Content="January"/>
                                    <ComboBoxItem Content="February"/>
                                    <ComboBoxItem Content="March"/>
                                    <ComboBoxItem Content="April"/>
                                    <ComboBoxItem Content="May"/>
                                    <ComboBoxItem Content="June"/>
                                    <ComboBoxItem Content="July"/>
                                    <ComboBoxItem Content="August"/>
                                    <ComboBoxItem Content="September"/>
                                    <ComboBoxItem Content="October"/>
                                    <ComboBoxItem Content="November"/>
                                    <ComboBoxItem Content="December"/>
                                </ComboBox>
                                <TextBlock Text="Year:" Margin="0,0,0,5"/>
                                <ComboBox SelectedValue="{Binding SelectedYear}" SelectedValuePath="Content" Margin="0,0,0,15">
                                    <ComboBoxItem Content="2024"/>
                                    <ComboBoxItem Content="2025"/>
                                    <ComboBoxItem Content="2026"/>
                                </ComboBox>
                            </StackPanel>

                            <Button Content="Load Recipients" Command="{Binding LoadRecipientsCommand}" Margin="0,0,0,15"/>

                            <!-- Recipients List -->
                            <TextBlock Text="Recipients:" FontWeight="Bold" Margin="0,0,0,5"/>
                            <ListBox ItemsSource="{Binding Recipients}"
                                    SelectedItem="{Binding SelectedRecipient}"
                                    MaxHeight="300"
                                    ScrollViewer.VerticalScrollBarVisibility="Auto">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding TenantName}" FontWeight="Bold"/>
                                            <TextBlock Text="{Binding HouseAddress}" FontSize="11" Foreground="Gray"/>
                                            <StackPanel Orientation="Horizontal" Margin="0,5,0,0">
                                                <TextBlock Text="📧" Visibility="{Binding HasEmail, Converter={StaticResource BoolToVis}}" Margin="0,0,5,0"/>
                                                <TextBlock Text="💬" Visibility="{Binding HasWhatsApp, Converter={StaticResource BoolToVis}}"/>
                                            </StackPanel>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </StackPanel>
                    </Border>

                    <!-- Right Panel: Message Composition -->
                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Channel and Template -->
                        <Border Grid.Row="0" Background="{DynamicResource CardFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,15" CornerRadius="8">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Channel:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox SelectedValue="{Binding SelectedChannel}" SelectedValuePath="Content" Width="120" Margin="0,0,20,0">
                                    <ComboBoxItem Content="Email"/>
                                    <ComboBoxItem Content="WhatsApp"/>
                                </ComboBox>
                                <TextBlock Text="Template:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                <ComboBox ItemsSource="{Binding Templates}"
                                         SelectedValue="{Binding SelectedTemplateId}"
                                         SelectedValuePath="TemplateId"
                                         DisplayMemberPath="Name"
                                         Width="200"/>
                            </StackPanel>
                        </Border>

                        <!-- Message Editor -->
                        <Grid Grid.Row="1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <!-- Editor -->
                            <StackPanel Grid.Column="0" Margin="0,0,10,0">
                                <TextBlock Text="Subject:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Subject, UpdateSourceTrigger=PropertyChanged}" 
                                        Margin="0,0,0,15" Padding="5"/>
                                <TextBlock Text="Body:" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding Body, UpdateSourceTrigger=PropertyChanged}" 
                                        TextWrapping="Wrap" AcceptsReturn="True"
                                        MinHeight="200" Padding="5"/>
                                <TextBlock Text="Variables: {TenantName}, {HouseAddress}, {AmountDue}, {DueDate}, {Month}, {DepositRemaining}, {PayInstructions}" 
                                          FontSize="10" Foreground="Gray" Margin="0,10,0,0"/>
                            </StackPanel>

                            <!-- Preview -->
                            <StackPanel Grid.Column="1">
                                <TextBlock Text="Preview:" Margin="0,0,0,5"/>
                                <Border BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="10" Background="{DynamicResource CardFillColorDefaultBrush}">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="300">
                                        <TextBlock Text="{Binding PreviewText}" TextWrapping="Wrap"/>
                                    </ScrollViewer>
                                </Border>
                                <Button Content="Preview" Command="{Binding PreviewMessageCommand}" Style="{StaticResource PrimaryButtonStyle}" Margin="0,10,0,0"/>
                            </StackPanel>
                        </Grid>

                        <!-- Actions -->
                        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                            <Button Content="Send Now" Command="{Binding SendNowCommand}" 
                                   Style="{StaticResource PrimaryButtonStyle}"
                                   Width="100" Height="30" Padding="8,4" Margin="0,0,10,0"/>
                            <StackPanel Orientation="Horizontal" Margin="0,0,10,0">
                                <DatePicker SelectedDate="{Binding ScheduledFor}" Width="150" Margin="0,0,10,0"/>
                                <Button Content="Queue" Command="{Binding QueueCommand}" 
                                       Width="100" Height="30" Padding="8,4"/>
                            </StackPanel>
                            <Button Content="Send Test" Command="{Binding SendTestCommand}" 
                                   Width="100" Height="30" Padding="8,4"/>
                        </StackPanel>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- Queue Tab -->
            <TabItem Header="Queue">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <Border Grid.Row="0" Background="{DynamicResource CardFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,15" CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox SelectedValue="Pending" SelectedValuePath="Content" Width="120" Margin="0,0,20,0">
                                <ComboBoxItem Content="Pending" IsSelected="True"/>
                                <ComboBoxItem Content="Sent"/>
                                <ComboBoxItem Content="Failed"/>
                            </ComboBox>
                            <Button Content="Refresh" Command="{Binding LoadQueueCommand}" Width="100" Style="{StaticResource PrimaryButtonStyle}"/>
                        </StackPanel>
                    </Border>

                    <!-- Queue Table -->
                    <DataGrid Grid.Row="1" 
                             ItemsSource="{Binding QueueNotifications}"
                             SelectedItem="{Binding SelectedNotification}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             IsReadOnly="True"
                             MinHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Scheduled For" Binding="{Binding ScheduledFor, StringFormat='{}{0:g}'}" Width="150"/>
                            <DataGridTextColumn Header="Tenant" Binding="{Binding TenantName}" Width="*"/>
                            <DataGridTextColumn Header="House" Binding="{Binding HouseAddress}" Width="*"/>
                            <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="80"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="Preview" Binding="{Binding BodyPreview}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Actions" Width="200">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Content="Send Now" 
                                                   Command="{Binding DataContext.SendQueueItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Width="80" Height="25" Margin="2"
                                                   Style="{StaticResource PrimaryButtonStyle}"
                                                   FontSize="11"/>
                                            <Button Content="Cancel" 
                                                   Command="{Binding DataContext.CancelQueueItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                   Width="70" Height="25" Margin="2"
                                                   Background="#D13438" Foreground="White" BorderBrush="#D13438" FontSize="11"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>

            <!-- History Tab -->
            <TabItem Header="History">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <!-- Filters -->
                    <Border Grid.Row="0" Background="{DynamicResource CardFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,15" CornerRadius="8">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                            <ComboBox SelectedValue="Sent" SelectedValuePath="Content" Width="120" Margin="0,0,20,0">
                                <ComboBoxItem Content="Sent" IsSelected="True"/>
                                <ComboBoxItem Content="Failed"/>
                            </ComboBox>
                            <Button Content="Refresh" Command="{Binding LoadHistoryCommand}" Width="100"/>
                        </StackPanel>
                    </Border>

                    <!-- History Table -->
                    <DataGrid Grid.Row="1" 
                             ItemsSource="{Binding HistoryNotifications}"
                             SelectedItem="{Binding SelectedNotification}"
                             AutoGenerateColumns="False"
                             CanUserAddRows="False"
                             IsReadOnly="True"
                             MinHeight="300">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Sent At" Binding="{Binding SentAt, StringFormat='{}{0:g}'}" Width="150"/>
                            <DataGridTextColumn Header="Tenant" Binding="{Binding TenantName}" Width="*"/>
                            <DataGridTextColumn Header="House" Binding="{Binding HouseAddress}" Width="*"/>
                            <DataGridTextColumn Header="Channel" Binding="{Binding Channel}" Width="80"/>
                            <DataGridTextColumn Header="Type" Binding="{Binding Type}" Width="120"/>
                            <DataGridTextColumn Header="Subject" Binding="{Binding Subject}" Width="*"/>
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{Binding Status, Converter={StaticResource StatusToColorConverter}}"/>
                                    </Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                            <DataGridTemplateColumn Header="Actions" Width="100">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Button Content="View" 
                                               Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                               Width="80" Height="25"
                                               Style="{StaticResource PrimaryButtonStyle}"
                                               FontSize="11"/>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </Grid>
            </TabItem>
        </TabControl>
    </Grid>
</UserControl>
