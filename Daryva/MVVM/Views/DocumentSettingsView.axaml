<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:conv="clr-namespace:Daryva.MVVM.Converters;assembly=Daryva"
             mc:Ignorable="d" d:DesignWidth="700" d:DesignHeight="600"
             x:Class="Daryva.MVVM.Views.DocumentSettingsView"
             x:CompileBindings="False">
    <UserControl.Resources>
        <conv:IntToStringConverter x:Key="IntToStringConverter"/>
    </UserControl.Resources>
    <ScrollViewer>
        <StackPanel Margin="0,0,0,24" Spacing="24">
            <!-- Header -->
            <TextBlock Text="Document Settings"
                       FontSize="24"
                       FontWeight="SemiBold"/>

            <!-- Upload Rules -->
            <Border BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    Padding="20,16">
                <StackPanel Spacing="20">
                    <TextBlock Text="Upload Rules"
                               FontSize="13"
                               FontWeight="Medium"
                               Opacity="0.85"
                               Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Max File Size (MB):"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding MaxFileSizeMB, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"
                                 MinWidth="80"
                                 Padding="8,6"/>
                    </Grid>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Allowed Formats:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                            <TextBox Text="{Binding AllowedFormats, Mode=TwoWay}"
                                     MinWidth="220"
                                     Padding="8,6"/>
                            <TextBlock Text="(PDF, JPG, PNG, DOCX)"
                                       FontSize="12"
                                       Opacity="0.7"
                                       VerticalAlignment="Center"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding AutoVersionDocuments, Mode=TwoWay}"
                                  Content="Auto-version documents"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Expiry Rules -->
            <Border BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    Padding="20,16">
                <StackPanel Spacing="20">
                    <TextBlock Text="Expiry Rules"
                               FontSize="13"
                               FontWeight="Medium"
                               Opacity="0.85"
                               Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Student Letter Validity (months):"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding StudentLetterValidityMonths, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"
                                 MinWidth="80"
                                 Padding="8,6"/>
                    </Grid>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Notify Before Expiry (days):"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <TextBox Grid.Column="1"
                                 Text="{Binding NotifyBeforeExpiryDays, Mode=TwoWay, Converter={StaticResource IntToStringConverter}}"
                                 MinWidth="80"
                                 Padding="8,6"/>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- Storage -->
            <Border BorderBrush="#E0E0E0"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    Padding="20,16">
                <StackPanel Spacing="20">
                    <TextBlock Text="Storage"
                               FontSize="13"
                               FontWeight="Medium"
                               Opacity="0.85"
                               Margin="0,0,0,4"/>

                    <Grid ColumnDefinitions="240,*" RowDefinitions="Auto">
                        <TextBlock Text="Document Storage Path:"
                                   VerticalAlignment="Center"
                                   Margin="0,0,12,0"/>
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                            <TextBox Text="{Binding DocumentStoragePath, Mode=TwoWay}"
                                     MinWidth="280"
                                     Padding="8,6"/>
                            <Button Content="Browse..."
                                    Command="{Binding BrowseStoragePathCommand}"
                                    Background="Transparent"
                                    BorderBrush="#E0E0E0"
                                    BorderThickness="1"/>
                        </StackPanel>
                    </Grid>

                    <StackPanel Spacing="12" Margin="0,8,0,0">
                        <CheckBox IsChecked="{Binding OpenDocumentsInApp, Mode=TwoWay}"
                                  Content="Open documents in app viewer"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Action buttons -->
            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Spacing="12">
                <Button Content="Reset"
                        Command="{Binding ResetCommand}"
                        Background="Transparent"
                        BorderBrush="#E0E0E0"
                        BorderThickness="1"/>
                <Button Content="Save"
                        Command="{Binding SaveCommand}"
                        Background="#2196F3"
                        Foreground="White"
                        BorderThickness="0"/>
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</UserControl>
