<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="600" d:DesignHeight="400"
             x:Class="Daryva.MVVM.Views.ThemeSettingsView"
             x:CompileBindings="False">
    <Border Padding="24">
        <StackPanel Spacing="24">
            <!-- Title -->
            <TextBlock Text="Theme Settings" 
                      FontSize="24" 
                      FontWeight="SemiBold"/>

            <!-- Theme Selection -->
            <StackPanel Spacing="12">
                <TextBlock Text="Select Theme" 
                          FontSize="16" 
                          FontWeight="Medium"/>

                <StackPanel Spacing="8">
                    <RadioButton x:Name="LightRadioButton"
                                Content="Light" 
                                Margin="0,0,0,8"
                                Checked="OnLightChecked"/>
                    <RadioButton x:Name="DarkRadioButton"
                                Content="Dark" 
                                Checked="OnDarkChecked"/>
                </StackPanel>

                <TextBlock Text="Theme changes are applied immediately and saved automatically." 
                          FontSize="12"
                          Margin="0,8,0,0"
                          TextWrapping="Wrap"
                          Opacity="0.7"/>
            </StackPanel>
        </StackPanel>
    </Border>
</UserControl>
