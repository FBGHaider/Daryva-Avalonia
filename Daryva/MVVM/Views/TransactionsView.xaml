<UserControl x:Class="Daryva.MVVM.Views.TransactionsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             mc:Ignorable="d" 
             d:DesignHeight="600" d:DesignWidth="1000">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Filters -->
        <Border Grid.Row="0" Background="{DynamicResource CardFillColorDefaultBrush}" BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1" Padding="15" Margin="0,0,0,15" CornerRadius="8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Date Range -->
                <TextBlock Grid.Column="0" Text="Date Range:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="1" 
                         SelectedValue="{Binding DateRangeFilter}"
                         SelectedValuePath="Content"
                         Width="150" Margin="0,0,20,0" Padding="5">
                    <ComboBox.Items>
                        <ComboBoxItem Content="This Month"/>
                        <ComboBoxItem Content="Last 3 Months"/>
                        <ComboBoxItem Content="This Year"/>
                        <ComboBoxItem Content="All"/>
                    </ComboBox.Items>
                </ComboBox>

                <!-- Payment Type -->
                <TextBlock Grid.Column="2" Text="Type:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="3" 
                         SelectedValue="{Binding PaymentTypeFilter}"
                         SelectedValuePath="Content"
                         Width="120" Margin="0,0,20,0" Padding="5">
                    <ComboBox.Items>
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Rent"/>
                        <ComboBoxItem Content="Deposit"/>
                    </ComboBox.Items>
                </ComboBox>

                <!-- House Filter -->
                <TextBlock Grid.Column="4" Text="House:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="5" 
                         ItemsSource="{Binding Houses}"
                         SelectedValue="{Binding SelectedHouseId}"
                         SelectedValuePath="HouseId"
                         DisplayMemberPath="AddressLine1"
                         Width="200" Margin="0,0,20,0" Padding="5"/>

                <!-- Tenant Filter -->
                <TextBlock Grid.Column="6" Text="Tenant:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="7" 
                         ItemsSource="{Binding Tenants}"
                         SelectedValue="{Binding SelectedTenantId}"
                         SelectedValuePath="TenantId"
                         DisplayMemberPath="FullName"
                         Width="200" Margin="0,0,20,0" Padding="5"/>

                <!-- Method Filter -->
                <TextBlock Grid.Column="8" Text="Method:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <ComboBox Grid.Column="9" 
                         SelectedValue="{Binding MethodFilter}"
                         SelectedValuePath="Content"
                         Width="120" Margin="0,0,20,0" Padding="5">
                    <ComboBox.Items>
                        <ComboBoxItem Content="All"/>
                        <ComboBoxItem Content="Bank Transfer"/>
                        <ComboBoxItem Content="Cash"/>
                        <ComboBoxItem Content="Card"/>
                        <ComboBoxItem Content="Other"/>
                    </ComboBox.Items>
                </ComboBox>

                <!-- Delete All Button (Testing) -->
                <Button Grid.Column="10" 
                       Content="🗑️ Delete All (TEST)" 
                       Command="{Binding DeleteAllTransactionsCommand}"
                       Background="#D13438" 
                       Foreground="White" 
                       BorderBrush="#D13438"
                       FontWeight="Bold"
                       Padding="10,5"
                       ToolTip="WARNING: This will delete ALL transactions. Testing feature only!">
                    <Button.Style>
                        <Style TargetType="Button">
                            <Setter Property="Background" Value="#D13438"/>
                            <Setter Property="BorderBrush" Value="#D13438"/>
                            <Setter Property="BorderThickness" Value="1"/>
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="#B02A2E"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
        </Border>

        <!-- Transactions Tables - Split into Rent and Deposit -->
        <Grid Grid.Row="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Rent Transactions Header -->
            <TextBlock Grid.Row="0" Text="Rent Transactions" FontSize="18" FontWeight="Bold" Margin="0,0,0,10"/>
            
            <!-- Rent Transactions Table -->
            <DataGrid Grid.Row="1" 
                     ItemsSource="{Binding RentTransactions}"
                     SelectedItem="{Binding SelectedTransaction}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     GridLinesVisibility="All"
                     HeadersVisibility="Column"
                     MouseDoubleClick="DataGrid_MouseDoubleClick"
                     Margin="0,0,0,20"
                     MinHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding PaidOn, StringFormat='dd/MM/yyyy HH:mm'}" Width="120"/>
                    <DataGridTextColumn Header="Tenant" Binding="{Binding TenantName}" Width="150"/>
                    <DataGridTextColumn Header="House" Binding="{Binding HouseAddress}" Width="200"/>
                    <DataGridTextColumn Header="Period" Binding="{Binding PeriodLabel}" Width="100"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='£{0:N2}'}" Width="100"/>
                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="120"/>
                    <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="150"/>
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Unrecord" 
                                       Command="{Binding DataContext.UnrecordPaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                       Padding="8,4" Margin="2,0"
                                       FontSize="11"
                                       MinWidth="80"
                                       Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#D13438"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#D13438"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Border"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#B02A2E"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Deposit Transactions Header -->
            <TextBlock Grid.Row="2" Text="Deposit Transactions" FontSize="18" FontWeight="Bold" Margin="0,10,0,10"/>
            
            <!-- Deposit Transactions Table -->
            <DataGrid Grid.Row="3" 
                     ItemsSource="{Binding DepositTransactions}"
                     SelectedItem="{Binding SelectedTransaction}"
                     AutoGenerateColumns="False"
                     IsReadOnly="True"
                     GridLinesVisibility="All"
                     HeadersVisibility="Column"
                     MouseDoubleClick="DataGrid_MouseDoubleClick"
                     MinHeight="200">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Date" Binding="{Binding PaidOn, StringFormat='dd/MM/yyyy HH:mm'}" Width="120"/>
                    <DataGridTextColumn Header="Tenant" Binding="{Binding TenantName}" Width="150"/>
                    <DataGridTextColumn Header="House" Binding="{Binding HouseAddress}" Width="200"/>
                    <DataGridTextColumn Header="Amount" Binding="{Binding Amount, StringFormat='£{0:N2}'}" Width="100"/>
                    <DataGridTextColumn Header="Method" Binding="{Binding Method}" Width="120"/>
                    <DataGridTextColumn Header="Reference" Binding="{Binding Reference}" Width="150"/>
                    <DataGridTemplateColumn Header="Actions" Width="150">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="Unrecord" 
                                       Command="{Binding DataContext.UnrecordPaymentCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                       Padding="8,4" Margin="2,0"
                                       FontSize="11"
                                       MinWidth="80"
                                       Cursor="Hand">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="#D13438"/>
                                            <Setter Property="Foreground" Value="White"/>
                                            <Setter Property="BorderBrush" Value="#D13438"/>
                                            <Setter Property="BorderThickness" Value="1"/>
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border x:Name="Border"
                                                                Background="{TemplateBinding Background}"
                                                                BorderBrush="{TemplateBinding BorderBrush}"
                                                                BorderThickness="{TemplateBinding BorderThickness}"
                                                                CornerRadius="4"
                                                                Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Border" Property="Background" Value="#B02A2E"/>
                                                            </Trigger>
                                                            <Trigger Property="IsEnabled" Value="False">
                                                                <Setter Property="Opacity" Value="0.4"/>
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </Grid>
</UserControl>
