<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:views="clr-namespace:Daryva.MVVM.Views"
             mc:Ignorable="d" d:DesignWidth="1000" d:DesignHeight="700"
             x:Class="Daryva.MVVM.Views.RentPaymentsView"
             x:CompileBindings="False"
             x:Name="Root">
    <Grid RowDefinitions="Auto,*">
        <!-- Fixed header: buttons follow right edge; hide when too narrow -->
        <Border Grid.Row="0" Padding="16,0,16,0" Margin="0,0,0,8" x:Name="HeaderBorder">
            <Grid ColumnDefinitions="*,Auto" HorizontalAlignment="Stretch">
                <TextBlock Grid.Column="0" Text="Rent &amp; Payments" FontSize="22" FontWeight="Bold" VerticalAlignment="Center" Margin="0,16,0,16"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,12,0,12"
                            IsVisible="{Binding IsHeaderButtonsVisible, RelativeSource={RelativeSource AncestorType=UserControl}}">
                    <Button Content="Record Payment" Command="{Binding RecordPaymentCommand}"/>
                    <Button Content="Export" Command="{Binding ExportLedgerCommand}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Scrollable content -->
        <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
            <Border Padding="16,0,16,16">
                <Grid RowDefinitions="*">
                <TabControl Grid.Row="0" SelectedIndex="{Binding SelectedTabIndex}" Margin="0,8,0,0">
                    <TabItem Header="Rent Ledger">
                        <views:RentLedgerView DataContext="{Binding LedgerViewModel}"/>
                    </TabItem>
                    <TabItem Header="Transactions">
                        <views:TransactionsView DataContext="{Binding TransactionsViewModel}"/>
                    </TabItem>
                </TabControl>
                </Grid>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
