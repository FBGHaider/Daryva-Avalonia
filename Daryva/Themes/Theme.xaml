<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <!-- WPF UI Theme Resources -->
    <!-- Note: Theme is applied via code-behind in App.xaml.cs -->
    <!-- The WPF UI resources are loaded automatically when ApplicationThemeManager.Apply() is called -->
    
    <!-- Fallback dark theme colors if WPF UI resources aren't loaded -->
    <SolidColorBrush x:Key="ApplicationBackgroundBrush" Color="#202020"/>
    <SolidColorBrush x:Key="CardFillColorDefaultBrush" Color="#2D2D2D"/>
    <SolidColorBrush x:Key="CardStrokeColorDefaultBrush" Color="#404040"/>
    <SolidColorBrush x:Key="ControlFillColorDefaultBrush" Color="#323232"/>
    <SolidColorBrush x:Key="ControlFillColorSecondaryBrush" Color="#3D3D3D"/>
    <SolidColorBrush x:Key="ControlFillColorTertiaryBrush" Color="#484848"/>
    <SolidColorBrush x:Key="ControlStrokeColorDefaultBrush" Color="#505050"/>
    <SolidColorBrush x:Key="TextFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="TextFillColorSecondaryBrush" Color="#CCCCCC"/>
    <SolidColorBrush x:Key="AccentFillColorDefaultBrush" Color="#0078D4"/>
    <SolidColorBrush x:Key="AccentFillColorSecondaryBrush" Color="#106EBE"/>
    <SolidColorBrush x:Key="TextOnAccentFillColorPrimaryBrush" Color="#FFFFFF"/>
    <SolidColorBrush x:Key="NavigationViewBackgroundBrush" Color="#1E1E1E"/>
    <SolidColorBrush x:Key="LayerFillColorDefaultBrush" Color="#252525"/>
</ResourceDictionary>
